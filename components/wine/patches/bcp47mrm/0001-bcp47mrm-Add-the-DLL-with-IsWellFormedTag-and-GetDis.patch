+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+
+#include "bcp47mrm.h"
+
+#include "wine/test.h"
+
+static void test_IsWellFormedTag(void)
+{
+    /* The examples of RFC 5646, appendix A, and some plain syntax errors. */
+    static const struct
+    {
+        const WCHAR *tag;
+        BOOL well_formed;
+    }
+    tests[] =
+    {
+        { L"de", TRUE },
+        { L"en-US", TRUE },
+        { L"zh-Hant", TRUE },
+        { L"zh-Hant-TW", TRUE },
+        { L"sr-Latn-RS", TRUE },
+        { L"es-419", TRUE },
+        { L"zh-yue-HK", TRUE },
+        { L"sl-rozaj-biske", TRUE },
+        { L"de-CH-1901", TRUE },
+        { L"hy-Latn-IT-arevela", TRUE },
+        { L"de-DE-u-co-phonebk", TRUE },
+        { L"en-US-x-twain", TRUE },
+        { L"x-whatever", TRUE },
+        { L"qaa-Qaaa-QM-x-southern", TRUE },
+        { L"i-klingon", TRUE },
+        { L"EN-us", TRUE },
+        { L"", FALSE },
+        { L"e", FALSE },
+        { L"a-DE", FALSE },
+        { L"de-419-DE", FALSE },
+        { L"en-", FALSE },
+        { L"-en", FALSE },
+        { L"en--US", FALSE },
+        { L"en_US", FALSE },
+        { L"en-US-x", FALSE },
+        { L"en-a-x-foo", FALSE },
+        { L"toolongtag", FALSE },
+        { L"en-toolongtag", FALSE },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        BOOL ret = IsWellFormedTag( tests[i].tag );
+        ok( !ret == !tests[i].well_formed, "%s: got %d.\n", debugstr_w(tests[i].tag), ret );
+    }
+}
+
+static void test_GetDistanceOfClosestLanguageInList(void)
+{
+    double distance;
+    HRESULT hr;
+
+    distance = -1.0;
+    hr = GetDistanceOfClosestLanguageInList( L"en-US", L"fr-FR;en-US;de-DE", ';', &distance );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( distance == 1.0, "got distance %f.\n", distance );
+
+    distance = -1.0;
+    hr = GetDistanceOfClosestLanguageInList( L"de-DE", L"fr-FR\0de-DE\0", 0, &distance );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( distance == 1.0, "got distance %f.\n", distance );
+
+    distance = -1.0;
+    hr = GetDistanceOfClosestLanguageInList( L"en-GB", L"fr-FR;en-US", ';', &distance );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( distance > 0.0 && distance < 1.0, "got distance %f.\n", distance );
+
+    distance = -1.0;
+    hr = GetDistanceOfClosestLanguageInList( L"en-US", L"fr-FR;de-DE", ';', &distance );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_NO_MATCH ), "got hr %#lx.\n", hr );
+    ok( distance == 0.0, "got distance %f.\n", distance );
+}
+
+START_TEST(bcp47mrm)
+{
+    test_IsWellFormedTag();
+    test_GetDistanceOfClosestLanguageInList();
+}
