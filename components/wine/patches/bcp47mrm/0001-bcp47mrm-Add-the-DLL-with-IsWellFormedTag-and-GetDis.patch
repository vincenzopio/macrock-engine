index 0000000000000000000000000000000000000000..aed114c24d817a94e7ba1b9c4c7e42ea6089c328
--- /dev/null
+++ b/dlls/bcp47mrm/main.c
@@ -0,0 +1,173 @@
+/*
+ * BCP 47 language tags for the Windows resource manager (MRM)
+ *
+ * Copyright 2026 vincenzopio (macrock)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+
+#include "bcp47mrm.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(bcp47mrm);
+
+/* The irregular grandfathered tags of RFC 5646, which the langtag syntax does not cover. */
+static const WCHAR *irregular_tags[] =
+{
+    L"en-GB-oed", L"i-ami", L"i-bnn", L"i-default", L"i-enochian", L"i-hak", L"i-klingon", L"i-lux",
+    L"i-mingo", L"i-navajo", L"i-pwn", L"i-tao", L"i-tay", L"i-tsu", L"sgn-BE-FR", L"sgn-BE-NL", L"sgn-CH-DE",
+};
+
+/* Where a subtag is in a tag, in the order of the langtag production of RFC 5646. */
+enum part
+{
+    PART_START,
+    PART_LANGUAGE,
+    PART_EXTLANG,
+    PART_SCRIPT,
+    PART_REGION,
+    PART_VARIANT,
+    PART_EXTENSION,
+    PART_PRIVATE_USE,
+};
+
+static BOOL is_alpha( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+static BOOL is_digit( WCHAR c )
+{
+    return c >= '0' && c <= '9';
+}
+
+static BOOL all_alpha( const WCHAR *str, unsigned int len )
+{
+    while (len--) if (!is_alpha( *str++ )) return FALSE;
+    return TRUE;
+}
+
+static BOOL all_digits( const WCHAR *str, unsigned int len )
+{
+    while (len--) if (!is_digit( *str++ )) return FALSE;
+    return TRUE;
+}
+
+/* Syntax only (RFC 5646 calls it well-formed): the subtags are not checked against the registry. */
+BOOL WINAPI IsWellFormedTag( const WCHAR *tag )
+{
+    const WCHAR *subtag = tag, *end;
+    enum part part = PART_START;
+    unsigned int i, len, extlangs = 0;
+    BOOL extlang_allowed = FALSE, pending = FALSE; /* a singleton or "x" needs one more subtag */
+
+    TRACE( "tag %s.\n", debugstr_w(tag) );
+
+    if (!tag) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(irregular_tags); i++)
+        if (!wcsicmp( tag, irregular_tags[i] )) return TRUE;
+
+    for (;;)
+    {
+        for (end = subtag; *end && *end != '-'; end++)
+            if (!is_alpha( *end ) && !is_digit( *end )) return FALSE;
+        len = end - subtag;
+        if (!len || len > 8) return FALSE;
+
+        if (part == PART_PRIVATE_USE) pending = FALSE;
+        else if (part == PART_EXTENSION && len > 1) pending = FALSE;
+        else if (len == 1)
+        {
+            BOOL private_use = subtag[0] == 'x' || subtag[0] == 'X';
+
+            /* A tag starts with a language or "x"; a singleton needs a subtag before the next one. */
+            if ((part == PART_START && !private_use) || pending) return FALSE;
+            part = private_use ? PART_PRIVATE_USE : PART_EXTENSION;
+            pending = TRUE;
+        }
+        else if (part == PART_START)
+        {
+            if (!all_alpha( subtag, len )) return FALSE;
+            part = PART_LANGUAGE;
+            extlang_allowed = len <= 3;
+        }
+        else if (len == 3 && all_alpha( subtag, len ) && extlang_allowed && part <= PART_EXTLANG && extlangs < 3)
+        {
+            part = PART_EXTLANG;
+            extlangs++;
+        }
+        else if (len == 4 && all_alpha( subtag, len ) && part < PART_SCRIPT)
+            part = PART_SCRIPT;
+        else if (((len == 2 && all_alpha( subtag, len )) || (len == 3 && all_digits( subtag, len ))) && part < PART_REGION)
+            part = PART_REGION;
+        else if ((len >= 5 || (len == 4 && is_digit( subtag[0] ))) && part <= PART_VARIANT)
+            part = PART_VARIANT;
+        else
+            return FALSE;
+
+        if (!*end) return !pending;
+        subtag = end + 1;
+    }
+}
+
+static unsigned int language_length( const WCHAR *tag, unsigned int len )
+{
+    unsigned int i = 0;
+
+    while (i < len && tag[i] != '-') i++;
+    return i;
+}
+
+/* 1.0 for the same tag, 0.5 for the same language, 0.0 otherwise. */
+static double tag_distance( const WCHAR *a, unsigned int a_len, const WCHAR *b, unsigned int b_len )
+{
+    unsigned int a_language = language_length( a, a_len ), b_language = language_length( b, b_len );
+
+    if (a_len == b_len && !wcsnicmp( a, b, a_len )) return 1.0;
+    if (a_language == b_language && !wcsnicmp( a, b, a_language )) return 0.5;
+    return 0.0;
+}
+
+HRESULT WINAPI GetDistanceOfClosestLanguageInList( const WCHAR *language, const WCHAR *list, WCHAR delimiter,
+                                                   double *distance )
+{
+    const WCHAR *tag, *end;
+    double best = 0.0, current;
+    unsigned int len;
+
+    TRACE( "language %s, list %s, delimiter %#x, distance %p.\n", debugstr_w(language), debugstr_w(list),
+           delimiter, distance );
+
+    if (!language || !list || !distance) return E_INVALIDARG;
+
+    /* With L'\0' as the delimiter, the list is double null-terminated. */
+    for (tag = list;; tag = end + 1)
+    {
+        if (delimiter) for (end = tag; *end && *end != delimiter; end++) ;
+        else end = tag + wcslen( tag );
+        if ((len = end - tag) && (current = tag_distance( language, wcslen( language ), tag, len )) > best)
+            best = current;
+        if (delimiter ? !*end : !len) break;
+    }
+
+    *distance = best;
+    return best > 0.0 ? S_OK : HRESULT_FROM_WIN32( ERROR_NO_MATCH );
+}
