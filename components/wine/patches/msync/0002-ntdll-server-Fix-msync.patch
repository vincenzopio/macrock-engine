+#define MSYNC_SHM_OBJECTS_PER_PAGE (MSYNC_SHM_PAGE_SIZE / MSYNC_SHM_OBJECT_SIZE)
+#define MSYNC_SHM_MAX_PAGES (MSYNC_SHM_INDEX_COUNT / MSYNC_SHM_OBJECTS_PER_PAGE)
+
+#endif /* __WINE_WINE_MSYNC_H */
