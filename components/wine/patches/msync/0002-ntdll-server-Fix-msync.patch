+    return mr;
 }
 
 static inline NTSTATUS msync_wait_single( int obj, void *obj_shm,
@@ -330,88 +334,136 @@ static inline NTSTATUS msync_wait_single( int obj, void *obj_shm,
     return STATUS_SUCCESS;
