+/* Only full paths name files: "C:\dir\file" or "\\server\share\file". */
+static BOOL is_full_path( const WCHAR *path )
+{
+    return (path[0] && path[1] == ':' && path[2] == '\\') || (path[0] == '\\' && path[1] == '\\');
+}
+
+static HRESULT get_file_from_path_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct storage_file *file = impl_from_IStorageFile( (IStorageFile *)param );
+    const WCHAR *path = storage_file_path( file );
+    DWORD attributes;
+
+    if (!is_full_path( path ))
+        return E_INVALIDARG;
+    if ((attributes = GetFileAttributesW( path )) == INVALID_FILE_ATTRIBUTES)
+        return HRESULT_FROM_WIN32( GetLastError() );
+    if (attributes & FILE_ATTRIBUTE_DIRECTORY)
+        return E_INVALIDARG;
+
+    result->vt = VT_UNKNOWN;
+    result->punkVal = param;
+    IUnknown_AddRef( param );
+    return S_OK;
+}
+
+static HRESULT WINAPI storage_file_statics_GetFileFromPathAsync( IStorageFileStatics *iface, HSTRING path,
+                                                                 IAsyncOperation_StorageFile **operation )
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer( path, NULL );
+    WCHAR *full_path = NULL;
+    IStorageFile *file;
+    DWORD length;
+    HRESULT hr;
+
+    TRACE( "iface %p, path %s, operation %p.\n", iface, debugstr_hstring( path ), operation );
+
+    *operation = NULL;
+    /* Resolve "." and ".." in full paths; others fail when the operation runs. */
+    if (is_full_path( buffer ) && (length = GetFullPathNameW( buffer, 0, NULL, NULL )))
+    {
+        if (!(full_path = malloc( length * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        if (GetFullPathNameW( buffer, length, full_path, NULL ) < length) buffer = full_path;
+    }
+    hr = storage_file_create( buffer, &file );
+    free( full_path );
+    if (FAILED(hr)) return hr;
+
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_StorageFile, (IUnknown *)iface, (IUnknown *)file,
+                                             get_file_from_path_async, (IAsyncOperation_IInspectable **)operation );
+    IStorageFile_Release( file );
+    return hr;
+}
