+static HRESULT get_file_from_path( IStorageFileStatics *statics, const WCHAR *path, IStorageFile **file )
+{
+    IAsyncOperation_StorageFile *operation = NULL;
+    IAsyncInfo *info;
+    AsyncStatus status;
+    HRESULT hr, error;
+    HSTRING str;
+
+    hr = WindowsCreateString( path, wcslen( path ), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageFileStatics_GetFileFromPathAsync( statics, str, &operation );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return hr;
+
+    check_interface( operation, &IID_IAgileObject, FALSE );
+    await_IAsyncOperation_StorageFile( operation, 5000 );
+
+    hr = IAsyncOperation_StorageFile_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncInfo_get_Status( info, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncInfo_get_ErrorCode( info, &error );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == (SUCCEEDED(error) ? Completed : Error), "got status %d, error %#lx.\n", status, error );
+    IAsyncInfo_Release( info );
+
+    *file = (void *)0xdeadbeef;
+    hr = IAsyncOperation_StorageFile_GetResults( operation, file );
+    ok( hr == error, "got hr %#lx, error %#lx.\n", hr, error );
+    if (FAILED(hr)) ok( !*file, "got file %p.\n", *file );
+    IAsyncOperation_StorageFile_Release( operation );
+    return hr;
+}
+
+static void check_hstring_( unsigned int line, HSTRING str, const WCHAR *expect )
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer( str, NULL );
+    ok_(__FILE__, line)( !wcscmp( buffer, expect ), "got %s, expected %s.\n", debugstr_w( buffer ), debugstr_w( expect ) );
+    WindowsDeleteString( str );
+}
+#define check_hstring( str, expect ) check_hstring_( __LINE__, str, expect )
+
+static void test_StorageFile(void)
+{
+    static const WCHAR *storage_file_name = L"Windows.Storage.StorageFile";
+    WCHAR temp[MAX_PATH], path[MAX_PATH], missing[MAX_PATH];
+    IStorageFileStatics *statics;
+    IActivationFactory *factory;
+    IStorageItem *item;
+    IStorageFile *file;
+    FileAttributes attributes;
+    DateTime created;
+    boolean is_type;
+    HSTRING str;
+    HANDLE handle;
+    HRESULT hr;
+    LONG ref;
+
+    if (FAILED(get_activation_factory( storage_file_name, &factory ))) return;
+
+    check_interface( factory, &IID_IUnknown, FALSE );
+    check_interface( factory, &IID_IInspectable, FALSE );
+    check_interface( factory, &IID_IAgileObject, FALSE );
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_IStorageFileStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( path, ARRAY_SIZE(path), L"%sstorage_file_test.txt", temp );
+    swprintf( missing, ARRAY_SIZE(missing), L"%sstorage_file_missing.txt", temp );
+    handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    ok( handle != INVALID_HANDLE_VALUE, "CreateFileW failed, error %lu.\n", GetLastError() );
+    CloseHandle( handle );
+
+    hr = get_file_from_path( statics, missing, &file );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ), "got hr %#lx.\n", hr );
+
+    hr = get_file_from_path( statics, path, &file );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        check_interface( file, &IID_IAgileObject, FALSE );
+
+        hr = IStorageFile_get_FileType( file, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, L".txt" );
+
+        hr = IStorageFile_QueryInterface( file, &IID_IStorageItem, (void **)&item );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IStorageItem_get_Name( item, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, L"storage_file_test.txt" );
+        hr = IStorageItem_get_Path( item, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, path );
+        hr = IStorageItem_get_Attributes( item, &attributes );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !(attributes & FileAttributes_Directory), "got attributes %#x.\n", attributes );
+        hr = IStorageItem_get_DateCreated( item, &created );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( created.UniversalTime > 0, "got time %s.\n", wine_dbgstr_longlong( created.UniversalTime ) );
+        hr = IStorageItem_IsOfType( item, StorageItemTypes_File, &is_type );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( is_type, "expected a file.\n" );
+        hr = IStorageItem_IsOfType( item, StorageItemTypes_Folder, &is_type );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !is_type, "expected no folder.\n" );
+        IStorageItem_Release( item );
+
+        ref = IStorageFile_Release( file );
+        ok( ref == 0, "got ref %ld.\n", ref );
+    }
+
+    DeleteFileW( path );
+    ref = IStorageFileStatics_Release( statics );
+    ok( ref == 1, "got ref %ld.\n", ref );
+    ref = IActivationFactory_Release( factory );
+    ok( ref == 0, "got ref %ld.\n", ref );
+}
