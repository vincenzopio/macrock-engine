+#ifndef __XGAMERUNTIME_XODUS_GAMELICENSE_H__
+#define __XGAMERUNTIME_XODUS_GAMELICENSE_H__
+
+#include "../private.h"
+
+/* What xodus-service found out about the account's license to a title. */
+struct XodusGameLicense
+{
+    BOOLEAN isActive;
+    BOOLEAN isTrial;
+    char skuStoreId[18]; /* "<product id>/<sku id>", empty when unknown */
+};
+
+/* Ask xodus-service, which asks the Store's licensing service with the account's Microsoft
+ * tokens, whether the account may play the title with this Store product id. Blocks until the
+ * reply comes: call it from a task queue. An account without a license succeeds with isActive
+ * FALSE; a failure to find out fails. */
+HRESULT XodusRequestGameLicense( const char *storeId, const char *market, XodusGameLicense *license );
+
+#endif
