+#include "../private.h"
+
+#include <atomic>
+#include <cstdio>
+#include <mutex>
+
+/* The error callback and options the title set, used by XErrorReport(). */
+static std::mutex errorLock;
+static XErrorCallback *errorCallback;
+static void *errorContext;
+static XErrorOptions optionsWithDebugger = XErrorOptions::None;
+static XErrorOptions optionsWithoutDebugger = XErrorOptions::None;
+
+void ReportError( HRESULT status, const char *message )
+{
+    XErrorCallback *callback;
+    XErrorOptions options;
+    void *context;
+
+    {
+        const std::lock_guard<std::mutex> lock( errorLock );
+        callback = errorCallback;
+        context = errorContext;
+        options = IsDebuggerPresent() ? optionsWithDebugger : optionsWithoutDebugger;
+    }
+
+    WARN( "status %#lx, message %s.\n", status, message ? message : "(null)" );
+    if ( callback ) callback( status, message, context );
+
+    if ( static_cast<UINT32>(options) & static_cast<UINT32>(XErrorOptions::OutputDebugStringOnError) )
+    {
+        char text[512];
+        snprintf( text, sizeof(text), "XError %#lx: %s\n", status, message ? message : "" );
+        OutputDebugStringA( text );
+    }
+    /* Breaking into a debugger or failing fast is not done: errors this runtime reports where
+     * Windows would not (it is incomplete) must not stop the game. */
+    if ( static_cast<UINT32>(options) & ( static_cast<UINT32>(XErrorOptions::DebugBreakOnError) |
+                                         static_cast<UINT32>(XErrorOptions::FailFastOnError) ) )
+        FIXME( "options %#x: not breaking or failing fast.\n", static_cast<UINT32>(options) );
+}
+
+class XErrorImpl :
+    public IXErrorImpl
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXErrorImpl ) )
+        {
+            AddRef();
+            *out = static_cast<IXErrorImpl *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override
+    {
+        return static_cast<ULONG>(++ref);
+    }
+
+    ULONG WINAPI Release() noexcept override
+    {
+        // A static object: never deleted.
+        return static_cast<ULONG>(--ref);
+    }
+
+    /* Unknown slot before XErrorSetCallback. */
+    HRESULT WINAPI __PADDING__() override
+    {
+        FIXME( "stub!\n" );
+        return E_NOTIMPL;
+    }
+
+    void WINAPI XErrorSetCallback( XErrorCallback *callback, void *context ) override
+    {
+        TRACE( "callback %p, context %p.\n", callback, context );
+        const std::lock_guard<std::mutex> lock( errorLock );
+        errorCallback = callback;
+        errorContext = context;
+    }
+
+    void WINAPI XErrorSetOptions( XErrorOptions optionsDebuggerPresent, XErrorOptions optionsDebuggerNotPresent ) override
+    {
+        TRACE( "optionsDebuggerPresent %#x, optionsDebuggerNotPresent %#x.\n",
+               static_cast<UINT32>(optionsDebuggerPresent), static_cast<UINT32>(optionsDebuggerNotPresent) );
+        const std::lock_guard<std::mutex> lock( errorLock );
+        optionsWithDebugger = optionsDebuggerPresent;
+        optionsWithoutDebugger = optionsDebuggerNotPresent;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XErrorImpl g_x_error;
+
+IXErrorImpl *x_error = static_cast<IXErrorImpl *>(&g_x_error);
