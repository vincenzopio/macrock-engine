+#include "../test_fixtures.h"
+
+#include <string>
+#include <windows.h>
+#include <xerror.h>
+
+class XErrorTests : public XGameRuntimeTests
+{
+};
+
+struct Reported
+{
+    int calls = 0;
+    HRESULT status = S_OK;
+    std::string message;
+};
+
+static void __stdcall OnError( HRESULT status, const char *message, void *context )
+{
+    Reported *reported = static_cast<Reported *>(context);
+    reported->calls++;
+    reported->status = status;
+    reported->message = message ? message : "";
+}
+
+// XErrorReport is the runtime's export that GDK libraries call to report an error.
+static HRESULT Report( HRESULT status, const char *message )
+{
+    typedef HRESULT (WINAPI *XErrorReportFn)( HRESULT, const char * );
+    auto report = reinterpret_cast<XErrorReportFn>(
+        GetProcAddress( GetModuleHandleA( "xgameruntime.dll" ), "XErrorReport" ));
+    return report ? report( status, message ) : E_FAIL;
+}
+
+TEST_F(XErrorTests, ReportCallsTheCallbackUntilItIsCleared)
+{
+    Reported reported;
+
+    XErrorSetCallback( OnError, &reported );
+    EXPECT_HRESULT_SUCCEEDED(Report( E_INVALIDARG, "bad argument" ));
+    EXPECT_EQ(reported.calls, 1);
+    EXPECT_EQ(reported.status, E_INVALIDARG);
+    EXPECT_EQ(reported.message, "bad argument");
+
+    XErrorSetCallback( nullptr, nullptr );
+    EXPECT_HRESULT_SUCCEEDED(Report( E_FAIL, "ignored" ));
+    EXPECT_EQ(reported.calls, 1);
+}
+
+TEST_F(XErrorTests, FailFastOptionDoesNotStopTheProcess)
+{
+    XErrorSetOptions( XErrorOptions::FailFastOnError, XErrorOptions::FailFastOnError );
+    EXPECT_HRESULT_SUCCEEDED(Report( E_FAIL, "still running" ));
+    XErrorSetOptions( XErrorOptions::None, XErrorOptions::None );
+}
