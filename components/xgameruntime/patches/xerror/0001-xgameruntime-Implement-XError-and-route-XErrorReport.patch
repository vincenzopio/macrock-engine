     return E_NOINTERFACE;
@@ -147,8 +149,8 @@ HRESULT WINAPI UninitializeApiImpl()
 
 HRESULT WINAPI XErrorReport( HRESULT status, LPCSTR message )
 {
-    TRACE("stub!\n");
-    return E_NOTIMPL;
+    ReportError( status, message );
+    return S_OK;
 }
 
