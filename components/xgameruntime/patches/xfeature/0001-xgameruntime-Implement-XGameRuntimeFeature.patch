@@ -121,6 +121,9 @@ HRESULT WINAPI QueryApiImpl( REFCLSID clsid, REFIID iid, void **out )
     //
     TRACE( "clsid %s, iid %s, out %p.\n", debugstr_guid( &clsid ), debugstr_guid( &iid ), out );
 
+    /* First: titles ask for it hundreds of times a second. */
+    if ( IsEqualGUID( clsid, CLSID_XGameRuntimeFeatureImpl ) )
