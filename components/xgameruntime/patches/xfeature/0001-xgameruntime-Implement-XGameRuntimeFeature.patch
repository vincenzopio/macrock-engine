+#include "../test_fixtures.h"
+
+#include <cstdio>
+#include <windows.h>
+#include <xgameruntimefeature.h>
+
+class XGameRuntimeFeatureTests : public XGameRuntimeTests
+{
+};
+
+TEST_F(XGameRuntimeFeatureTests, FeaturesAreAvailable)
+{
+    EXPECT_TRUE(XGameRuntimeIsFeatureAvailable(XGameRuntimeFeature::XSystem));
+    EXPECT_TRUE(XGameRuntimeIsFeatureAvailable(XGameRuntimeFeature::XUser));
+    EXPECT_TRUE(XGameRuntimeIsFeatureAvailable(XGameRuntimeFeature::XGameStreaming));
+}
+
+// Games call it hundreds of times a second through QueryApiImpl; keep that path cheap.
+TEST_F(XGameRuntimeFeatureTests, IsFeatureAvailableIsCheap)
+{
+    LARGE_INTEGER frequency, start, end;
+    unsigned available = 0;
+
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&start);
+    for (int i = 0; i < 100000; i++)
+        available += XGameRuntimeIsFeatureAvailable(XGameRuntimeFeature::XSystem);
+    QueryPerformanceCounter(&end);
+
+    double microseconds = (end.QuadPart - start.QuadPart) * 1e6 / frequency.QuadPart / 100000;
+    std::printf("[ MEASURED ] %.3f us per XGameRuntimeIsFeatureAvailable call\n", microseconds);
+    EXPECT_EQ(available, 100000u);
+    EXPECT_LT(microseconds, 10.0);
+}
