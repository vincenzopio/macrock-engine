+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "GameConfig.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+
+static GameConfig config;
+static std::once_flag configOnce;
+
+/* The first MicrosoftGame.config beside the executable or in a parent directory. */
+static HRESULT FindConfig( char *path, DWORD size )
+{
+    static const char name[] = "MicrosoftGame.config";
+    char *last;
+    DWORD length = GetModuleFileNameA( nullptr, path, size );
+
+    if ( !length || length >= size ) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+
+    while ( ( last = strrchr( path, '\\' ) ) )
+    {
+        last[1] = '\0';
+        if ( strlen( path ) + sizeof(name) > size ) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        strcat( path, name );
+        if ( GetFileAttributesA( path ) != INVALID_FILE_ATTRIBUTES ) return S_OK;
+        *last = '\0';
+    }
+    return E_GAME_MISSING_GAME_CONFIG;
+}
+
+static HRESULT ParseConfig( xmlDocPtr doc )
+{
+    xmlNodePtr root = xmlDocGetRootElement( doc ), child;
+
+    if ( !root || strcmp( (const char *)root->name, "Game" ) ) return E_GAMERUNTIME_GAMECONFIG_BAD_FORMAT;
+
+    for ( child = root->children; child; child = child->next )
+    {
+        char *value, *end;
+
+        if ( child->type != XML_ELEMENT_NODE ) continue;
+        if ( !( value = (char *)xmlNodeGetContent( child ) ) ) continue;
+
+        if ( !strcmp( (const char *)child->name, "TitleId" ) )
+        {
+            unsigned long id = strtoul( value, &end, 16 );
+            if ( end == value || *end || id > 0xffffffffUL )
+            {
+                xmlFree( value );
+                return E_GAMERUNTIME_GAMECONFIG_BAD_FORMAT;
+            }
+            config.titleId = (UINT32)id;
+        }
+        else if ( !strcmp( (const char *)child->name, "MSAAppId" ) )
+            lstrcpynA( config.msaAppId, value, sizeof(config.msaAppId) );
+        else if ( !strcmp( (const char *)child->name, "MSAFullTrust" ) )
+            config.msaFullTrust = !strcmp( value, "true" );
+
+        xmlFree( value );
+    }
+    return S_OK;
+}
+
+static HRESULT ReadConfig( const INITIALIZE_OPTIONS *options )
+{
+    char path[MAX_PATH];
+    xmlDocPtr doc;
+    HRESULT hr;
+
+    if ( options && options->gameConfig && options->isInlineConfig )
+        doc = xmlReadMemory( options->gameConfig, (int)strlen( options->gameConfig ), nullptr, nullptr, XML_PARSE_NONET );
+    else if ( options && options->gameConfig )
+        doc = xmlReadFile( options->gameConfig, nullptr, XML_PARSE_NONET );
+    else
+    {
+        if ( FAILED( hr = FindConfig( path, sizeof(path) ) ) ) return hr;
+        doc = xmlReadFile( path, nullptr, XML_PARSE_NONET );
+    }
+    if ( !doc ) return E_GAMERUNTIME_GAMECONFIG_BAD_FORMAT;
+
+    hr = ParseConfig( doc );
+    xmlFreeDoc( doc );
+    return hr;
+}
+
+HRESULT LoadGameConfig( const INITIALIZE_OPTIONS *options )
+{
+    std::call_once( configOnce, [options]
+    {
+        config.status = ReadConfig( options );
+        if ( SUCCEEDED( config.status ) )
+            TRACE( "title id %#x, MSA full trust %d.\n", config.titleId, config.msaFullTrust );
+        else
+            WARN( "cannot read MicrosoftGame.config, hr %#lx.\n", config.status );
+    } );
+    return config.status;
+}
+
+const GameConfig &GetGameConfig()
+{
+    return config;
+}
