+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "../private.h"
+#include "GameConfig.h"
+
+#include <atomic>
+
+class XGameImpl :
+    public IXGameImpl3
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXGameImpl ) ||
+             iid == __uuidof( IXGameImpl2 ) ||
+             iid == __uuidof( IXGameImpl3 ) )
+        {
+            AddRef();
+            *out = static_cast<IXGameImpl3 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override
+    {
+        return static_cast<ULONG>(++ref);
+    }
+
+    ULONG WINAPI Release() noexcept override
+    {
+        // A static object: never deleted.
+        return static_cast<ULONG>(--ref);
+    }
+
+    HRESULT WINAPI XGameGetXboxTitleId( UINT32 *titleId ) override
+    {
+        const GameConfig &config = GetGameConfig();
+
+        TRACE( "titleId %p.\n", titleId );
+
+        if ( !titleId ) return E_POINTER;
+        if ( FAILED( config.status ) ) return config.status;
+        *titleId = config.titleId;
+        return S_OK;
+    }
+
+    void WINAPI XLaunchNewGame( const char *exePath, const char *args, XUserHandle defaultUser ) override
+    {
+        FIXME( "exePath %s, args %s, defaultUser %p stub!\n", exePath ? exePath : "(null)", args ? args : "(null)",
+               defaultUser );
+    }
+
+    HRESULT WINAPI XLaunchRestartOnCrash( const char *args, UINT32 reserved ) override
+    {
+        FIXME( "args %s, reserved %u stub!\n", args ? args : "(null)", reserved );
+        return E_NOTIMPL;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XGameImpl g_x_game;
+
+IXGameImpl3 *x_game = static_cast<IXGameImpl3 *>(&g_x_game);
