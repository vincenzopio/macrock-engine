+#include "../test_fixtures.h"
+
+#include <windows.h>
+#include <xgame.h>
+
+class XGameTests : public XGameRuntimeTests
+{
+};
+
+TEST_F(XGameTests, TitleIdComesFromTheConfigAsHexadecimal)
+{
+    UINT32 titleId = 0;
+
+    // tests/MicrosoftGame.config has <TitleId>1A2B3C4D</TitleId>.
+    EXPECT_HRESULT_SUCCEEDED(XGameGetXboxTitleId(&titleId));
+    EXPECT_EQ(titleId, 0x1A2B3C4Du);
+}
+
+TEST_F(XGameTests, TitleIdNeedsAPointer)
+{
+    EXPECT_EQ(XGameGetXboxTitleId(nullptr), E_POINTER);
+}
+
+TEST_F(XGameTests, RestartOnCrashIsNotImplemented)
+{
+    EXPECT_EQ(XLaunchRestartOnCrash(nullptr, 0), E_NOTIMPL);
+}
