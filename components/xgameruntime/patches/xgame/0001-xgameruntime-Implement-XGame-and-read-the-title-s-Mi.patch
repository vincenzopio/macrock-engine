+#ifndef __XGAMERUNTIME_GAMECONFIG_H__
+#define __XGAMERUNTIME_GAMECONFIG_H__
+
+#include "../private.h"
+
+/* What the runtime needs from the title's MicrosoftGame.config. */
+struct GameConfig
+{
+    HRESULT status = E_GAMERUNTIME_NOT_INITIALIZED; /* S_OK once read; why it could not be otherwise */
+    UINT32 titleId = 0;                             /* <TitleId>, hexadecimal in the file */
+    char msaAppId[64] = "";                         /* <MSAAppId> */
+    BOOLEAN msaFullTrust = FALSE;                   /* <MSAFullTrust> */
+};
+
+/* Read the configuration once: inline or from the path in options, or else the first
+ * MicrosoftGame.config found beside the executable or in a parent directory. Later calls return
+ * the status of the first one. */
+HRESULT LoadGameConfig( const INITIALIZE_OPTIONS *options );
+
+const GameConfig &GetGameConfig();
+
