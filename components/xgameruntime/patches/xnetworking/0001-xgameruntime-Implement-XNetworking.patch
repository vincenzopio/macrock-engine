+
+#include "../private.h"
+
+#include <winhttp.h>
+#include <atomic>
+#include <map>
+#include <mutex>
+
+/* What a Windows desktop with a working connection reports; there is no change notification
+ * from the host, so this never changes. */
+static void FillConnectivityHint( XNetworkingConnectivityHint *hint )
+{
+    *hint = XNetworkingConnectivityHint{};
+    hint->connectivityLevel = XNetworkingConnectivityLevelHint::InternetAccess;
+    hint->connectivityCost = XNetworkingConnectivityCostHint::Unrestricted;
+    hint->networkInitialized = TRUE;
+}
+
+/* Connectivity hint registrations, by token. */
+struct HintRegistration
+{
+    void *context;
+    XNetworkingConnectivityHintChangedCallback *callback;
+};
+static std::mutex hintLock;
+static std::map<UINT64, HintRegistration> hintRegistrations;
+static UINT64 nextHintToken = 1;
+
+static void CALLBACK NotifyConnectivityHint( void *context, BOOLEAN canceled )
+{
+    UINT64 token = reinterpret_cast<UINT64>(context);
+    XNetworkingConnectivityHint hint;
+    HintRegistration registration;
+
+    if ( canceled ) return;
+    {
+        const std::lock_guard<std::mutex> lock( hintLock );
+        auto found = hintRegistrations.find( token );
+        if ( found == hintRegistrations.end() ) return; /* unregistered meanwhile */
+        registration = found->second;
+    }
+    FillConnectivityHint( &hint );
+    registration.callback( registration.context, &hint );
+}
+
+static const char securityInformationIdentity[] = "XNetworkingQuerySecurityInformationForUrlAsync";
+
+static HRESULT CALLBACK SecurityInformationProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+            XAsyncComplete( data->async, S_OK, sizeof(XNetworkingSecurityInformation) );
+            return S_OK;
+
+        case XAsyncOp::GetResult:
+        {
+            auto *information = static_cast<XNetworkingSecurityInformation *>(data->buffer);
+            /* The protocols a current Windows enables; no certificate pinning (thumbprints). */
+            information->enabledHttpSecurityProtocolFlags = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 |
+                                                            WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+            information->thumbprintCount = 0;
+            information->thumbprints = nullptr;
+            return S_OK;
+        }
+
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT SecurityInformationResult( XAsyncBlock *asyncBlock, SIZE_T bufferSize, SIZE_T *bufferUsed,
+                                          UINT8 *buffer, XNetworkingSecurityInformation **information )
+{
+    HRESULT hr;
+
+    if ( !asyncBlock || !buffer || !information ) return E_POINTER;
+    if ( SUCCEEDED( hr = XAsyncGetResult( asyncBlock, securityInformationIdentity, bufferSize, buffer, bufferUsed ) ) )
+        *information = reinterpret_cast<XNetworkingSecurityInformation *>(buffer);
+    return hr;
+}
+
+class XNetworkingImpl :
+    public IXNetworkingImpl2
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXNetworkingImpl ) ||
+             iid == __uuidof( IXNetworkingImpl2 ) )
+        {
+            AddRef();
+            *out = static_cast<IXNetworkingImpl2 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override
+    {
+        return static_cast<ULONG>(++ref);
+    }
+
+    ULONG WINAPI Release() noexcept override
+    {
+        // A static object: never deleted.
+        return static_cast<ULONG>(--ref);
+    }
+
+    HRESULT WINAPI XNetworkingQueryPreferredLocalUdpMultiplayerPort( UINT16 *preferredLocalUdpMultiplayerPort ) override
+    {
+        FIXME( "preferredLocalUdpMultiplayerPort %p stub!\n", preferredLocalUdpMultiplayerPort );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XNetworkingQueryPreferredLocalUdpMultiplayerPortAsync( XAsyncBlock *asyncBlock ) override
+    {
+        FIXME( "asyncBlock %p stub!\n", asyncBlock );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XNetworkingQueryPreferredLocalUdpMultiplayerPortAsyncResult( XAsyncBlock *asyncBlock,
+                                                                                UINT16 *preferredLocalUdpMultiplayerPort ) override
+    {
+        FIXME( "asyncBlock %p, preferredLocalUdpMultiplayerPort %p stub!\n", asyncBlock, preferredLocalUdpMultiplayerPort );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XNetworkingRegisterPreferredLocalUdpMultiplayerPortChanged( XTaskQueueHandle queue, void *context,
+            XNetworkingPreferredLocalUdpMultiplayerPortChangedCallback *callback, XTaskQueueRegistrationToken *token ) override
+    {
+        FIXME( "queue %p, context %p, callback %p, token %p stub!\n", queue, context, callback, token );
+        return E_NOTIMPL;
+    }
+
+    BOOLEAN WINAPI XNetworkingUnregisterPreferredLocalUdpMultiplayerPortChanged( XTaskQueueRegistrationToken token,
+                                                                                 BOOLEAN wait ) override
+    {
+        FIXME( "token %llu, wait %d stub!\n", (unsigned long long)token.token, wait );
+        return FALSE;
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlAsync( const char *url, XAsyncBlock *asyncBlock ) override
+    {
+        TRACE( "asyncBlock %p.\n", asyncBlock );
+        if ( !url || !asyncBlock ) return E_POINTER;
+        return XAsyncBegin( asyncBlock, nullptr, securityInformationIdentity, securityInformationIdentity,
+                            SecurityInformationProvider );
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlAsyncResultSize( XAsyncBlock *asyncBlock,
+                                                                             SIZE_T *bufferByteCount ) override
+    {
+        if ( !asyncBlock || !bufferByteCount ) return E_POINTER;
+        return XAsyncGetResultSize( asyncBlock, bufferByteCount );
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlAsyncResult( XAsyncBlock *asyncBlock, SIZE_T bufferByteCount,
+            SIZE_T *bufferByteCountUsed, UINT8 *buffer, XNetworkingSecurityInformation **securityInformation ) override
+    {
+        return SecurityInformationResult( asyncBlock, bufferByteCount, bufferByteCountUsed, buffer, securityInformation );
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlUtf16Async( const WCHAR *url, XAsyncBlock *asyncBlock ) override
+    {
+        TRACE( "url %p, asyncBlock %p.\n", url, asyncBlock );
+        if ( !url || !asyncBlock ) return E_POINTER;
+        return XAsyncBegin( asyncBlock, nullptr, securityInformationIdentity, securityInformationIdentity,
+                            SecurityInformationProvider );
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlUtf16AsyncResultSize( XAsyncBlock *asyncBlock,
+                                                                                  SIZE_T *bufferByteCount ) override
+    {
+        return XNetworkingQuerySecurityInformationForUrlAsyncResultSize( asyncBlock, bufferByteCount );
+    }
+
+    HRESULT WINAPI XNetworkingQuerySecurityInformationForUrlUtf16AsyncResult( XAsyncBlock *asyncBlock,
+            SIZE_T bufferByteCount, SIZE_T *bufferByteCountUsed, UINT8 *buffer,
+            XNetworkingSecurityInformation **securityInformation ) override
+    {
+        return SecurityInformationResult( asyncBlock, bufferByteCount, bufferByteCountUsed, buffer, securityInformation );
+    }
+
+    /* Pinning only: no thumbprints are reported, and WinHTTP verified the chain, the dates and the
+     * host name when it connected. */
+    HRESULT WINAPI XNetworkingVerifyServerCertificate( void *requestHandle,
+                                                      const XNetworkingSecurityInformation *securityInformation ) override
+    {
+        if ( !requestHandle || !securityInformation ) return E_POINTER;
+        if ( securityInformation->thumbprintCount )
+            FIXME( "%Iu certificate thumbprints not checked (pinning is not implemented).\n",
+                   securityInformation->thumbprintCount );
+        return S_OK;
+    }
+
+    HRESULT WINAPI XNetworkingGetConnectivityHint( XNetworkingConnectivityHint *connectivityHint ) override
+    {
+        TRACE( "connectivityHint %p.\n", connectivityHint );
+        if ( !connectivityHint ) return E_POINTER;
+        FillConnectivityHint( connectivityHint );
+        return S_OK;
+    }
+
+    /* The hint never changes, so the callback runs once, soon after registration, on the given
+     * queue (or the process queue). */
+    HRESULT WINAPI XNetworkingRegisterConnectivityHintChanged( XTaskQueueHandle queue, void *context,
+            XNetworkingConnectivityHintChangedCallback *callback, XTaskQueueRegistrationToken *token ) override
+    {
+        XTaskQueueHandle processQueue = nullptr;
+        UINT64 id;
+        HRESULT hr;
+
+        TRACE( "queue %p, context %p, callback %p, token %p.\n", queue, context, callback, token );
+        if ( !callback || !token ) return E_POINTER;
+        {
+            const std::lock_guard<std::mutex> lock( hintLock );
+            id = nextHintToken++;
+            hintRegistrations[id] = HintRegistration{ context, callback };
+        }
+        token->token = id;
+
+        if ( !queue && XTaskQueueGetCurrentProcessTaskQueue( &processQueue ) ) queue = processQueue;
+        if ( queue )
+        {
+            if ( FAILED( hr = XTaskQueueSubmitCallback( queue, XTaskQueuePort::Completion, reinterpret_cast<void *>(id),
+                                                        NotifyConnectivityHint ) ) )
+                WARN( "cannot queue the first connectivity hint, hr %#lx.\n", hr );
+        }
+        if ( processQueue ) XTaskQueueCloseHandle( processQueue );
+        return S_OK;
+    }
+
+    BOOLEAN WINAPI XNetworkingUnregisterConnectivityHintChanged( XTaskQueueRegistrationToken token, BOOLEAN wait ) override
+    {
+        TRACE( "token %llu, wait %d.\n", (unsigned long long)token.token, wait );
+        const std::lock_guard<std::mutex> lock( hintLock );
+        return hintRegistrations.erase( token.token ) != 0;
+    }
+
+    HRESULT WINAPI XNetworkingQueryConfigurationSetting( XNetworkingConfigurationSetting setting, UINT64 *value ) override
+    {
+        FIXME( "setting %u, value %p stub!\n", static_cast<UINT32>(setting), value );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XNetworkingSetConfigurationSetting( XNetworkingConfigurationSetting setting, UINT64 value ) override
+    {
+        FIXME( "setting %u, value %llu stub!\n", static_cast<UINT32>(setting), (unsigned long long)value );
+        return E_NOTIMPL;
+    }
+
+    HRESULT WINAPI XNetworkingQueryStatistics( XNetworkingStatisticsType type, XNetworkingStatisticsBuffer *buffer ) override
+    {
+        FIXME( "type %u, buffer %p stub!\n", static_cast<UINT32>(type), buffer );
+        return E_NOTIMPL;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XNetworkingImpl g_x_networking;
+
+IXNetworkingImpl2 *x_networking = static_cast<IXNetworkingImpl2 *>(&g_x_networking);
