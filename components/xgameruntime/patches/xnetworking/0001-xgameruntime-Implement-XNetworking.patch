+#include "../test_fixtures.h"
+
+#include <vector>
+#include <windows.h>
+#include <winhttp.h>
+#include <xasync.h>
+#include <xnetworking.h>
+#include <xtaskqueue.h>
+
+class XNetworkingTests : public XGameRuntimeTests
+{
+};
+
+TEST_F(XNetworkingTests, ConnectivityHintSaysInternet)
+{
+    XNetworkingConnectivityHint hint{};
+
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingGetConnectivityHint(&hint));
+    EXPECT_EQ(hint.connectivityLevel, XNetworkingConnectivityLevelHint::InternetAccess);
+    EXPECT_EQ(hint.connectivityCost, XNetworkingConnectivityCostHint::Unrestricted);
+    EXPECT_TRUE(hint.networkInitialized);
+    EXPECT_FALSE(hint.roaming);
+    EXPECT_EQ(XNetworkingGetConnectivityHint(nullptr), E_POINTER);
+}
+
+static void CheckSecurityInformation(XAsyncBlock *block, bool utf16)
+{
+    SIZE_T size = 0, used = 0;
+    XNetworkingSecurityInformation *information = nullptr;
+
+    EXPECT_HRESULT_SUCCEEDED(XAsyncGetStatus(block, TRUE));
+    EXPECT_HRESULT_SUCCEEDED(utf16 ? XNetworkingQuerySecurityInformationForUrlUtf16AsyncResultSize(block, &size)
+                                   : XNetworkingQuerySecurityInformationForUrlAsyncResultSize(block, &size));
+    ASSERT_GE(size, sizeof(XNetworkingSecurityInformation));
+    std::vector<UINT8> buffer(size);
+    EXPECT_HRESULT_SUCCEEDED(utf16
+        ? XNetworkingQuerySecurityInformationForUrlUtf16AsyncResult(block, size, &used, buffer.data(), &information)
+        : XNetworkingQuerySecurityInformationForUrlAsyncResult(block, size, &used, buffer.data(), &information));
+    ASSERT_NE(information, nullptr);
+    EXPECT_EQ(reinterpret_cast<UINT8 *>(information), buffer.data());
+    EXPECT_TRUE(information->enabledHttpSecurityProtocolFlags & WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2);
+    EXPECT_EQ(information->thumbprintCount, 0u);
+}
+
+TEST_F(XNetworkingTests, SecurityInformationHasNoPinning)
+{
+    XAsyncBlock block{};
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingQuerySecurityInformationForUrlAsync("https://example.com/", &block));
+    CheckSecurityInformation(&block, false);
+
+    XAsyncBlock block16{};
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingQuerySecurityInformationForUrlUtf16Async(L"https://example.com/", &block16));
+    CheckSecurityInformation(&block16, true);
+
+    EXPECT_EQ(XNetworkingQuerySecurityInformationForUrlAsync(nullptr, &block), E_POINTER);
+}
+
+TEST_F(XNetworkingTests, VerifyServerCertificateAcceptsWithoutPinning)
+{
+    XNetworkingSecurityInformation information{};
+    int request = 0;
+
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingVerifyServerCertificate(&request, &information));
+    EXPECT_EQ(XNetworkingVerifyServerCertificate(&request, nullptr), E_POINTER);
+}
+
+struct HintCalls
+{
+    int calls = 0;
+    XNetworkingConnectivityLevelHint level = XNetworkingConnectivityLevelHint::Unknown;
+};
+
+static void __stdcall OnHint(void *context, const XNetworkingConnectivityHint *hint)
+{
+    auto *calls = static_cast<HintCalls *>(context);
+    calls->calls++;
+    calls->level = hint->connectivityLevel;
+}
+
+TEST_F(XNetworkingTests, ConnectivityHintCallbackRunsOnceOnTheQueue)
+{
+    XTaskQueueHandle queue = nullptr;
+    XTaskQueueRegistrationToken token{}, unused{};
+    HintCalls calls, canceled;
+
+    ASSERT_HRESULT_SUCCEEDED(XTaskQueueCreate(XTaskQueueDispatchMode::Manual, XTaskQueueDispatchMode::Manual, &queue));
+
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingRegisterConnectivityHintChanged(queue, &calls, OnHint, &token));
+    EXPECT_EQ(calls.calls, 0); // not called during registration
+    EXPECT_HRESULT_SUCCEEDED(XNetworkingRegisterConnectivityHintChanged(queue, &canceled, OnHint, &unused));
+    EXPECT_TRUE(XNetworkingUnregisterConnectivityHintChanged(unused, TRUE)); // before its callback ran
+
+    while (XTaskQueueDispatch(queue, XTaskQueuePort::Completion, 100)) {}
+    EXPECT_EQ(calls.calls, 1);
+    EXPECT_EQ(calls.level, XNetworkingConnectivityLevelHint::InternetAccess);
+    EXPECT_EQ(canceled.calls, 0);
+
+    EXPECT_TRUE(XNetworkingUnregisterConnectivityHintChanged(token, TRUE));
+    EXPECT_FALSE(XNetworkingUnregisterConnectivityHintChanged(token, TRUE));
+    XTaskQueueCloseHandle(queue);
+}
+
+// Minecraft asks for IXNetworkingImpl2: its own methods must be in the vtable.
+TEST_F(XNetworkingTests, SecondInterfaceMethodsExist)
+{
+    XNetworkingStatisticsBuffer statistics{};
+    UINT64 value = 0;
+
+    EXPECT_EQ(XNetworkingQueryStatistics(XNetworkingStatisticsType::TitleTcpQueuedReceivedBufferUsage, &statistics), E_NOTIMPL);
+    EXPECT_EQ(XNetworkingQueryConfigurationSetting(XNetworkingConfigurationSetting::MaxTitleTcpQueuedReceiveBufferSize, &value), E_NOTIMPL);
+}
