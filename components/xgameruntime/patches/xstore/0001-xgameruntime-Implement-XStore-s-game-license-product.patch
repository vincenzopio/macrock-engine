+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "../private.h"
+#include "../Xodus/GameLicense.h"
+#include "GameConfig.h"
+#include "XboxLive.h"
+#include "XUser.h"
+
+#include <atomic>
+#include <cwctype>
+#include <deque>
+#include <string>
+#include <vector>
+
+static std::string Join( const char **ids, SIZE_T count )
+{
+    std::string joined;
+    for ( SIZE_T i = 0; ids && i < count; ++i )
+        joined += std::string( i ? "," : "" ) + ( ids[i] ? ids[i] : "(null)" );
+    return joined;
+}
+
+/* A store context holds nothing: there is one user. */
+struct XStoreContext
+{
+};
+
+/* Asynchronous stubs still start and complete with E_NOTIMPL: titles wait for the completion. */
+static HRESULT CALLBACK FailProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    if ( op == XAsyncOp::Begin ) return XAsyncSchedule( data->async, 0 );
+    if ( op == XAsyncOp::DoWork ) XAsyncComplete( data->async, (HRESULT)(INT_PTR)data->context, 0 );
+    return S_OK;
+}
+
+static HRESULT FailAsync( XAsyncBlock *async, HRESULT hr = E_NOTIMPL )
+{
+    if ( !async ) return E_POINTER;
+    return XAsyncBegin( async, (void *)(INT_PTR)hr, nullptr, nullptr, FailProvider );
+}
+
+/* The failure, which also releases the call. */
+static HRESULT FailedResult( XAsyncBlock *async )
+{
+    if ( !async ) return E_POINTER;
+    return XAsyncGetResult( async, nullptr, 0, nullptr, nullptr );
+}
+
+/* The Store market of the user's region ("IT"), or "US". */
+static void GetMarket( char market[3] )
+{
+    WCHAR region[16];
+
+    strcpy( market, "US" );
+    if ( GetUserDefaultGeoName( region, (int)(sizeof(region) / sizeof(*region)) ) == 3 && iswalpha( region[0] ) &&
+         iswalpha( region[1] ) )
+    {
+        market[0] = (char)towupper( region[0] );
+        market[1] = (char)towupper( region[1] );
+    }
+}
+
+/* A page of a title's associated products, read from the Store's public catalog, and where the
+ * next page starts. The products' strings and arrays live as long as the page. */
+struct XStoreProductQuery
+{
+    /* Entitled products are unknown: such a query has none, in one page. */
+    BOOL entitled = FALSE;
+    XStoreProductKind kinds = XStoreProductKind::None;
+    UINT32 pageSize = 25, skip = 0, total = 0;
+    std::string storeId, market, locale;
+    BOOL handedOut = FALSE; /* the title owns it and closes it */
+
+    std::vector<XStoreProduct> products;
+    std::vector<std::vector<XStoreSku>> skus;                   /* moving a vector keeps its buffer */
+    std::vector<std::vector<XStoreAvailability>> availabilities;
+    std::deque<std::string> strings;                            /* a deque keeps its elements in place */
+
+    const char *Keep( const std::string &text )
+    {
+        strings.push_back( text );
+        return strings.back().c_str();
+    }
+};
+
+static XStoreProductKind KindOf( const std::string &type )
+{
+    if ( type == "Durable" ) return XStoreProductKind::Durable;
+    if ( type == "Consumable" ) return XStoreProductKind::Consumable;
+    if ( type == "UnmanagedConsumable" ) return XStoreProductKind::UnmanagedConsumable;
+    if ( type == "Game" ) return XStoreProductKind::Game;
+    if ( type == "Pass" ) return XStoreProductKind::Pass;
+    return XStoreProductKind::None;
+}
+
+/* The catalog gives one price, already formatted for the market: no sale, no recurrence. */
+static void FillPrice( XStoreProductQuery *query, double price, const std::string &formatted,
+                       const std::string &currency, XStorePrice *out )
+{
+    out->basePrice = out->price = (float)price;
+    out->currencyCode = query->Keep( currency );
+    lstrcpynA( out->formattedBasePrice, formatted.c_str(), sizeof(out->formattedBasePrice) );
+    lstrcpynA( out->formattedPrice, formatted.c_str(), sizeof(out->formattedPrice) );
+}
+
+static HRESULT ReadProductPage( XStoreProductQuery *query )
+{
+    std::vector<XboxLive::StoreAddOn> addOns;
+    HRESULT hr;
+
+    if ( FAILED( hr = XboxLive::QueryStoreAddOns( query->storeId.c_str(), query->market.c_str(),
+                                                  query->locale.c_str(), query->skip, query->pageSize, &addOns,
+                                                  &query->total ) ) )
+        return hr;
+    query->products.reserve( addOns.size() );
+    for ( const XboxLive::StoreAddOn &addOn : addOns )
+    {
+        XStoreProductKind kind = KindOf( addOn.type );
+        if ( !( static_cast<UINT32>(kind) & static_cast<UINT32>(query->kinds) ) ) continue;
+
+        XStoreProduct product{};
+        product.storeId = query->Keep( addOn.productId );
+        product.title = query->Keep( addOn.title );
+        product.description = query->Keep( addOn.description );
+        product.language = query->Keep( query->locale );
+        product.inAppOfferToken = query->Keep( "" );
+        product.linkUri = const_cast<char *>(query->Keep( "ms-windows-store://pdp/?ProductId=" + addOn.productId ));
+        product.productKind = kind;
+        FillPrice( query, addOn.price, addOn.displayPrice, addOn.skus.empty() ? "" : addOn.skus[0].currencyCode,
+                   &product.price );
+        /* Ownership is not in the public catalog: isInUserCollection stays FALSE. */
+
+        std::vector<XStoreSku> skus;
+        std::vector<XStoreAvailability> availabilities;
+        skus.reserve( addOn.skus.size() );
+        availabilities.reserve( addOn.skus.size() ); /* the skus point into it */
+        for ( const XboxLive::StoreSku &storeSku : addOn.skus )
+        {
+            XStoreSku sku{};
+            XStoreAvailability availability{};
+
+            sku.skuId = query->Keep( storeSku.skuId );
+            sku.title = query->Keep( storeSku.title.empty() ? addOn.title : storeSku.title );
+            sku.description = product.description;
+            sku.language = product.language;
+            FillPrice( query, storeSku.price, storeSku.displayPrice, storeSku.currencyCode, &sku.price );
+            sku.isTrial = storeSku.type == "trial";
+            availability.availabilityId = query->Keep( storeSku.availabilityId );
+            availability.price = sku.price;
+            availabilities.push_back( availability );
+            sku.availabilitiesCount = 1;
+            sku.availabilities = &availabilities.back();
+            skus.push_back( sku );
+        }
+        product.skusCount = (UINT32)skus.size();
+        product.skus = skus.data();
+        query->skus.push_back( std::move( skus ) );
+        query->availabilities.push_back( std::move( availabilities ) );
+        query->products.push_back( product );
+    }
+    TRACE( "products %u-%u of %u: %zu of the kinds asked.\n", query->skip, query->skip + query->pageSize,
+           query->total, query->products.size() );
+    return S_OK;
+}
+
+/* Every product query's result is a query handle, whichever *Result function a title reads it
+ * with: Minecraft reads XStoreQueryAssociatedProductsAsync's with XStoreQueryProductsResult. */
+static const char productQueryIdentity[] = "XStoreProductQuery";
+
+static HRESULT CALLBACK ProductQueryProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    auto *query = static_cast<XStoreProductQuery *>(data->context);
+
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+        {
+            HRESULT hr = query->storeId.empty() ? E_GAMEPACKAGE_NO_STORE_ID :
+                         query->entitled ? S_OK : ReadProductPage( query );
+            if ( FAILED( hr ) ) WARN( "product page from %u failed, hr %#lx.\n", query->skip, hr );
+            XAsyncComplete( data->async, hr, SUCCEEDED( hr ) ? sizeof(XStoreProductQueryHandle) : 0 );
+            return S_OK;
+        }
+
+        case XAsyncOp::GetResult:
+            *static_cast<XStoreProductQueryHandle *>(data->buffer) = query;
+            query->handedOut = TRUE;
+            return S_OK;
+
+        case XAsyncOp::Cleanup:
+            if ( !query->handedOut ) delete query;
+            return S_OK;
+
+        default:
+            return S_OK;
+    }
+}
+
+/* Start reading a page of the title's associated products of some kinds, from skip on. */
+static HRESULT BeginProductQuery( XStoreProductKind kinds, UINT32 pageSize, UINT32 skip, XAsyncBlock *async,
+                                  BOOL entitled = FALSE )
+{
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH];
+    char market[3];
+    HRESULT hr;
+
+    if ( !async ) return E_POINTER;
+    auto *query = new XStoreProductQuery();
+    query->entitled = entitled;
+    query->kinds = kinds;
+    query->pageSize = pageSize && pageSize < 25 ? pageSize : 25; /* the catalog's largest page */
+    query->skip = skip;
+    query->storeId = GetGameConfig().storeId;
+    GetMarket( market );
+    query->market = market;
+    query->locale = "en-US";
+    if ( GetUserDefaultLocaleName( locale, LOCALE_NAME_MAX_LENGTH ) )
+    {
+        std::string name;
+        for ( const WCHAR *c = locale; *c && ( iswalnum( *c ) || *c == '-' ); ++c ) name += (char)*c;
+        if ( name.size() >= 2 ) query->locale = name;
+    }
+
+    if ( FAILED( hr = XAsyncBegin( async, query, productQueryIdentity, productQueryIdentity, ProductQueryProvider ) ) )
+        delete query;
+    return hr;
+}
+
+static HRESULT ProductQueryResult( XAsyncBlock *async, XStoreProductQueryHandle *handle )
+{
+    if ( !async || !handle ) return E_POINTER;
+    *handle = nullptr;
+    return XAsyncGetResult( async, productQueryIdentity, sizeof(*handle), handle, nullptr );
+}
+
+/* Microsoft Store ID keys ("User Store ID" in the GDK documentation): the title's service gives
+ * a ticket, the Store answers a key with which that service can see or change the user's
+ * entitlements. Both are credentials, never logged. */
+struct StoreIdKeyCall
+{
+    const wchar_t *host, *path;
+    std::string body, key;
+};
+
+static const char collectionsIdIdentity[] = "XStoreGetUserCollectionsIdAsync";
+static const char purchaseIdIdentity[] = "XStoreGetUserPurchaseIdAsync";
+
+static HRESULT CALLBACK StoreIdKeyProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    auto *call = static_cast<StoreIdKeyCall *>(data->context);
+
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+        {
+            std::string url = "https://" + XboxLive::Narrow( call->host ) + XboxLive::Narrow( call->path );
+            std::string token, signature;
+            HRESULT hr;
+
+            if ( SUCCEEDED( hr = XUserTokenForRequest( "POST", url.c_str(), call->body, &token, &signature ) ) )
+                hr = XboxLive::RequestStoreIdKey( call->host, call->path, call->body, token, signature, &call->key );
+            if ( FAILED( hr ) ) WARN( "no Store ID key, hr %#lx.\n", hr );
+            XAsyncComplete( data->async, hr, SUCCEEDED( hr ) ? call->key.size() + 1 : 0 );
+            return S_OK;
+        }
+
+        case XAsyncOp::GetResult:
+            memcpy( data->buffer, call->key.c_str(), call->key.size() + 1 );
+            return S_OK;
+
+        case XAsyncOp::Cleanup:
+            delete call;
+            return S_OK;
+
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT BeginStoreIdKey( const wchar_t *host, const wchar_t *path, const char *identity,
+                                const char *serviceTicket, const char *publisherUserId, XAsyncBlock *async )
+{
+    HRESULT hr;
+
+    auto *call = new StoreIdKeyCall{ host, path, XboxLive::StoreIdKeyRequestBody( serviceTicket, publisherUserId ) };
+    if ( FAILED( hr = XAsyncBegin( async, call, identity, identity, StoreIdKeyProvider ) ) ) delete call;
+    return hr;
+}
+
+static const char gameLicenseIdentity[] = "XStoreQueryGameLicenseAsync";
+
+static HRESULT CALLBACK GameLicenseProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    auto *license = static_cast<XStoreGameLicense *>(data->context);
+
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+        {
+            const GameConfig &config = GetGameConfig();
+            XodusGameLicense found{};
+            char market[3];
+            HRESULT hr;
+
+            GetMarket( market );
+            if ( !config.storeId[0] ) hr = E_GAMEPACKAGE_NO_STORE_ID;
+            else if ( ( hr = XodusRequestGameLicense( config.storeId, market, &found ) ) == E_FAIL )
+                hr = E_GAMESTORE_SERVER_ERROR;
+            if ( SUCCEEDED( hr ) )
+            {
+                lstrcpynA( license->skuStoreId, found.skuStoreId, sizeof(license->skuStoreId) );
+                license->isActive = found.isActive;
+                license->isTrial = found.isTrial;
+                license->isTrialOwnedByThisUser = found.isTrial;
+            }
+            else WARN( "no game license for %s, hr %#lx.\n", config.storeId, hr );
+            XAsyncComplete( data->async, hr, SUCCEEDED( hr ) ? sizeof(*license) : 0 );
+            return S_OK;
+        }
+
+        case XAsyncOp::GetResult:
+            memcpy( data->buffer, license, sizeof(*license) );
+            return S_OK;
+
+        case XAsyncOp::Cleanup:
+            delete license;
+            return S_OK;
+
+        default:
+            return S_OK;
+    }
+}
+
+class XStoreImpl : public IXStoreImpl6
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+        if ( iid == __uuidof( IUnknown ) || iid == __uuidof( IXStoreImpl ) || iid == __uuidof( IXStoreImpl2 ) ||
+             iid == __uuidof( IXStoreImpl3 ) || iid == __uuidof( IXStoreImpl4 ) || iid == __uuidof( IXStoreImpl5 ) ||
+             iid == __uuidof( IXStoreImpl6 ) )
+        {
+            *out = static_cast<IXStoreImpl6 *>(this);
+            AddRef();
+            return S_OK;
+        }
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override { return static_cast<ULONG>(++ref); }
+
+    // A static object: never deleted.
+    ULONG WINAPI Release() noexcept override { return static_cast<ULONG>(--ref); }
+
+    /* IXStoreImpl */
+    HRESULT WINAPI XStoreCreateContext( const XUserHandle user, XStoreContextHandle *storeContextHandle ) override
+    {
+        if ( !storeContextHandle ) return E_POINTER;
+        *storeContextHandle = new XStoreContext{};
+        return S_OK;
+    }
+
+    void WINAPI XStoreCloseContextHandle( XStoreContextHandle storeContextHandle ) override
+    {
+        delete static_cast<XStoreContext *>(storeContextHandle);
+    }
+
+    HRESULT WINAPI XStoreQueryAssociatedProductsAsync( const XStoreContextHandle storeContextHandle,
+                                                       XStoreProductKind productKinds, UINT32 maxItemsToRetrievePerPage,
+                                                       XAsyncBlock *async ) override
+    {
+        TRACE( "kinds %#x, page %u.\n", static_cast<UINT32>(productKinds), maxItemsToRetrievePerPage );
+        if ( !storeContextHandle ) return E_INVALIDARG;
+        return BeginProductQuery( productKinds, maxItemsToRetrievePerPage, 0, async );
+    }
+
+    HRESULT WINAPI XStoreQueryAssociatedProductsResult( XAsyncBlock *async,
+                                                        XStoreProductQueryHandle *productQueryHandle ) override
+    {
+        return ProductQueryResult( async, productQueryHandle );
+    }
+
+    HRESULT WINAPI XStoreQueryProductsAsync( const XStoreContextHandle storeContextHandle,
+                                             XStoreProductKind productKinds, const char **storeIds,
+                                             SIZE_T storeIdsCount, const char **actionFilters,
+                                             SIZE_T actionFiltersCount, XAsyncBlock *async ) override
+    {
+        FIXME( "kinds %#x, ids %s, filters %s stub!\n", static_cast<UINT32>(productKinds),
+               Join( storeIds, storeIdsCount ).c_str(), Join( actionFilters, actionFiltersCount ).c_str() );
+        return FailAsync( async );
+    }
+
+    HRESULT WINAPI XStoreQueryProductsResult( XAsyncBlock *async,
+                                              XStoreProductQueryHandle *productQueryHandle ) override
+    {
+        return ProductQueryResult( async, productQueryHandle );
+    }
+
+    HRESULT WINAPI XStoreQueryEntitledProductsAsync( const XStoreContextHandle storeContextHandle,
+                                                     XStoreProductKind productKinds, UINT32 maxItemsToRetrievePerPage,
+                                                     XAsyncBlock *async ) override
+    {
+        FIXME( "kinds %#x, page %u: ownership is unknown, no products.\n", static_cast<UINT32>(productKinds),
+               maxItemsToRetrievePerPage );
+        if ( !storeContextHandle ) return E_INVALIDARG;
+        return BeginProductQuery( productKinds, maxItemsToRetrievePerPage, 0, async, TRUE );
+    }
+
+    HRESULT WINAPI XStoreQueryEntitledProductsResult( XAsyncBlock *async,
+                                                      XStoreProductQueryHandle *productQueryHandle ) override
+    {
+        return ProductQueryResult( async, productQueryHandle );
+    }
+
+    HRESULT WINAPI XStoreQueryProductForCurrentGameAsync( const XStoreContextHandle storeContextHandle,
+                                                          XAsyncBlock *async ) override
+    {
+        FIXME( "stub!\n" );
+        return FailAsync( async );
+    }
+
+    HRESULT WINAPI XStoreQueryProductForCurrentGameResult( XAsyncBlock *async,
+                                                           XStoreProductQueryHandle *productQueryHandle ) override
+    {
+        FIXME( "stub!\n" );
+        return FailedResult( async );
+    }
+
+    HRESULT WINAPI XStoreQueryProductForPackageAsync( const XStoreContextHandle storeContextHandle,
+                                                      XStoreProductKind productKinds, const char *packageIdentifier,
+                                                      XAsyncBlock *async ) override
+    {
+        FIXME( "kinds %#x, package %s stub!\n", static_cast<UINT32>(productKinds),
+               packageIdentifier ? packageIdentifier : "(null)" );
+        return FailAsync( async );
+    }
+
+    HRESULT WINAPI XStoreQueryProductForPackageResult( XAsyncBlock *async,
+                                                       XStoreProductQueryHandle *productQueryHandle ) override
