+HRESULT XUserTokenForRequest( const char *method, const char *url, const std::string &body, std::string *token,
+                              std::string *signature )
+{
+    TokenContext context;
+    HRESULT hr;
+
+    {
+        const std::lock_guard<std::mutex> lock( usersLock );
+        if ( !signedInUser ) return E_GAMEUSER_NO_DEFAULT_USER;
+        AddRef( signedInUser );
+        context.user = signedInUser;
+    }
+    context.request.method = method;
+    context.request.url = url;
+    context.request.body.assign( body.begin(), body.end() );
+    if ( SUCCEEDED( hr = ComputeTokenAndSignature( &context ) ) )
+    {
+        *token = std::move( context.token );
+        *signature = std::move( context.signature );
+    }
+    Release( context.user );
+    return hr;
+}
+
 /* The result: the structure, then the token and the signature, each with a terminating NUL that
  * the sizes count (as Xal documents). A request that is not signed has a null signature. */
 static SIZE_T TokenResultSize( const TokenContext &context )
