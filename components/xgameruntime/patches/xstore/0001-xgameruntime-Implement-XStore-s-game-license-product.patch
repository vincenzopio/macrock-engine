+#include <xstore.h>
+
+class XStoreTests : public XGameRuntimeTests
+{
+};
+
+TEST_F(XStoreTests, ContextsAreChecked)
+{
+    XStoreContextHandle context = nullptr;
+    XAsyncBlock block{};
+
+    EXPECT_EQ(XStoreCreateContext(nullptr, nullptr), E_POINTER);
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    EXPECT_NE(context, nullptr);
+    EXPECT_EQ(XStoreQueryGameLicenseAsync(nullptr, &block), E_INVALIDARG);
+    EXPECT_EQ(XStoreQueryGameLicenseAsync(context, nullptr), E_POINTER);
+    XStoreCloseContextHandle(context);
+}
+
+// Titles wait for the completion even of a call that cannot succeed (Minecraft stops loading):
+// it has to come.
+TEST_F(XStoreTests, GameLicenseNeedsAStoreId)
+{
+    XStoreContextHandle context = nullptr;
+    XStoreGameLicense license{};
+    XAsyncBlock block{};
+
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryGameLicenseAsync(context, &block));
+    EXPECT_EQ(XAsyncGetStatus(&block, TRUE), E_GAMEPACKAGE_NO_STORE_ID);
+    EXPECT_EQ(XStoreQueryGameLicenseResult(&block, &license), E_GAMEPACKAGE_NO_STORE_ID);
+    XStoreCloseContextHandle(context);
+}
+
+TEST_F(XStoreTests, UnimplementedCallsComplete)
+{
+    XStoreContextHandle context = nullptr;
+    XStoreProductQueryHandle query = nullptr;
+    XAsyncBlock block{};
+
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryProductForCurrentGameAsync(context, &block));
+    EXPECT_EQ(XAsyncGetStatus(&block, TRUE), E_NOTIMPL);
+    EXPECT_EQ(XStoreQueryProductForCurrentGameResult(&block, &query), E_NOTIMPL);
+    XStoreCloseContextHandle(context);
+}
+
+static BOOLEAN CALLBACK CountProduct( const XStoreProduct *product, void *context )
+{
+    ++*static_cast<int *>(context);
+    return TRUE;
+}
+
+// The associated products come from the title's Store id, which the tests' configuration lacks.
+TEST_F(XStoreTests, AssociatedProductsNeedAStoreId)
+{
+    XStoreContextHandle context = nullptr;
+    XStoreProductQueryHandle query = nullptr;
+    XAsyncBlock block{};
+
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryAssociatedProductsAsync(context, XStoreProductKind::Durable, 25, &block));
+    EXPECT_EQ(XAsyncGetStatus(&block, TRUE), E_GAMEPACKAGE_NO_STORE_ID);
+    EXPECT_EQ(XStoreQueryAssociatedProductsResult(&block, &query), E_GAMEPACKAGE_NO_STORE_ID);
+    EXPECT_EQ(query, nullptr);
+    XStoreCloseContextHandle(context);
+}
+
+class XStoreLiveTests : public XGameRuntimeTests
+{
+protected:
+    void SetUp() override
+    {
+        const char *live = getenv("XGR_LIVE_XBOX");
+        if (!live || strcmp(live, "1")) GTEST_SKIP() << "set XGR_LIVE_XBOX=1 to ask for the real license";
+    }
+};
+
+struct ProductSearch
+{
+    int products = 0;
+    std::string realmsPrice;
+};
+
+static BOOLEAN CALLBACK FindRealmsPlus( const XStoreProduct *product, void *context )
+{
+    auto *search = static_cast<ProductSearch *>(context);
+
+    ++search->products;
+    if ( strstr( product->title, "Realms Plus Monthly" ) && !strstr( product->title, "trial" ) && product->skusCount )
+        search->realmsPrice = std::string( product->price.formattedPrice ) + " " + product->price.currencyCode;
+    return TRUE;
+}
+
+// The title's add-ons, from the Store's public catalog, page by page (Minecraft: 225, 25 a page).
+TEST_F(XStoreLiveTests, AssociatedProductsComeFromTheCatalog)
+{
+    XStoreContextHandle context = nullptr;
+    XStoreProductQueryHandle query = nullptr;
+    ProductSearch search;
+    XAsyncBlock block{};
+    int pages = 0;
+
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryAssociatedProductsAsync(
+        context, static_cast<XStoreProductKind>(0x1f), 25, &block));
+    ASSERT_HRESULT_SUCCEEDED(XAsyncGetStatus(&block, TRUE));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryAssociatedProductsResult(&block, &query));
+    for ( ;; )
+    {
+        ++pages;
+        ASSERT_HRESULT_SUCCEEDED(XStoreEnumerateProductsQuery(query, &search, FindRealmsPlus));
+        if ( !XStoreProductsQueryHasMorePages(query) ) break;
+        XAsyncBlock next{};
+        XStoreProductQueryHandle nextQuery = nullptr;
+        ASSERT_HRESULT_SUCCEEDED(XStoreProductsQueryNextPageAsync(query, &next));
+        ASSERT_HRESULT_SUCCEEDED(XAsyncGetStatus(&next, TRUE));
+        ASSERT_HRESULT_SUCCEEDED(XStoreProductsQueryNextPageResult(&next, &nextQuery));
+        XStoreCloseProductsQueryHandle(query);
+        query = nextQuery;
+    }
+    XStoreCloseProductsQueryHandle(query);
+    std::printf("[   LIVE   ] associated products: %d in %d pages; Realms Plus monthly: %s\n", search.products, pages,
+                search.realmsPrice.c_str());
+    EXPECT_GT(search.products, 0);
+    EXPECT_GT(pages, 1);
+    EXPECT_FALSE(search.realmsPrice.empty());
+    XStoreCloseContextHandle(context);
+}
+
+TEST_F(XStoreLiveTests, GameLicenseIsTheAccounts)
+{
+    XStoreContextHandle context = nullptr;
+    XStoreGameLicense license{};
+    XAsyncBlock block{};
+
+    ASSERT_HRESULT_SUCCEEDED(XStoreCreateContext(nullptr, &context));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryGameLicenseAsync(context, &block));
+    ASSERT_HRESULT_SUCCEEDED(XAsyncGetStatus(&block, TRUE));
+    ASSERT_HRESULT_SUCCEEDED(XStoreQueryGameLicenseResult(&block, &license));
+    std::printf("[   LIVE   ] game license: active %d, trial %d, sku %s\n", license.isActive, license.isTrial,
+                license.skuStoreId);
+    EXPECT_TRUE(license.isActive);
+    EXPECT_FALSE(license.isTrial);
+    EXPECT_NE(strchr(license.skuStoreId, '/'), nullptr); // "<product id>/<sku id>"
+    XStoreCloseContextHandle(context);
+}
