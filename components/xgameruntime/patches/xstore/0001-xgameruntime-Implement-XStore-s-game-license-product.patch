+HRESULT QueryStoreAddOns( const char *productId, const char *market, const char *locale, UINT32 skip, UINT32 count,
+                          std::vector<StoreAddOn> *addOns, UINT32 *total )
+{
+    char path[256];
+    std::string response;
+    Ref<IJsonObject> object, payload;
+    Ref<IJsonArray> list;
+    DWORD status = 0;
+    HRESULT hr;
+
+    snprintf( path, sizeof(path),
+              "/v9.0/products/%s/addons?market=%s&locale=%s&deviceFamily=Windows.Desktop&pageSize=%u&skipItems=%u",
+              productId, market, locale, count, skip );
+    if ( FAILED( hr = HttpRequest( L"GET", L"storeedgefd.dsx.mp.microsoft.com", Widen( path ).c_str(),
+                                   L"Accept: application/json\r\n", std::string(), &status, &response ) ) )
+        return hr;
+    if ( status != 200 )
+    {
+        WARN( "Store add-ons failed: HTTP %lu.\n", status );
+        return E_GAMESTORE_SERVER_ERROR;
+    }
+    if ( FAILED( hr = ParseObject( response, &object ) ) || FAILED( hr = GetObject( object.get(), L"Payload", &payload ) ) )
+        return hr;
+    *total = (UINT32)GetDouble( payload.get(), L"TotalItems" );
+    addOns->clear();
+    if ( FAILED( GetArray( payload.get(), L"AddOns", &list ) ) ) return S_OK;
+
+    for ( UINT32 i = 0;; ++i )
+    {
+        Ref<IJsonObject> entry;
+        Ref<IJsonArray> skus;
+        StoreAddOn addOn;
+
+        if ( ( hr = list->GetObjectAt( i, &entry ) ) == E_BOUNDS ) break;
+        if ( FAILED( hr ) ) return hr;
+        if ( FAILED( GetString( entry.get(), L"ProductId", &addOn.productId ) ) ) continue;
+        GetString( entry.get(), L"Title", &addOn.title );
+        GetString( entry.get(), L"Description", &addOn.description );
+        GetString( entry.get(), L"ProductType", &addOn.type );
+        GetString( entry.get(), L"DisplayPrice", &addOn.displayPrice );
+        addOn.price = GetDouble( entry.get(), L"Price" );
+        if ( FAILED( GetArray( entry.get(), L"Skus", &skus ) ) ) skus.reset();
+        for ( UINT32 j = 0; skus.get(); ++j )
+        {
+            Ref<IJsonObject> skuEntry;
+            StoreSku sku;
+
+            if ( FAILED( skus->GetObjectAt( j, &skuEntry ) ) ) break;
+            GetString( skuEntry.get(), L"SkuId", &sku.skuId );
+            GetString( skuEntry.get(), L"SkuTitle", &sku.title );
+            GetString( skuEntry.get(), L"SkuType", &sku.type );
+            GetString( skuEntry.get(), L"AvailabilityId", &sku.availabilityId );
+            GetString( skuEntry.get(), L"DisplayPrice", &sku.displayPrice );
+            GetString( skuEntry.get(), L"CurrencyCode", &sku.currencyCode );
+            sku.price = GetDouble( skuEntry.get(), L"Price" );
+            addOn.skus.push_back( std::move( sku ) );
+        }
+        addOns->push_back( std::move( addOn ) );
+    }
+    return S_OK;
+}
+
+std::string StoreIdKeyRequestBody( const char *serviceTicket, const char *publisherUserId )
+{
+    std::string body = "{\"serviceTicket\":\"" + JsonEscape( serviceTicket ) + "\"";
+    if ( publisherUserId && *publisherUserId ) body += ",\"publisherUserId\":\"" + JsonEscape( publisherUserId ) + "\"";
+    return body + "}";
+}
+
+HRESULT RequestStoreIdKey( const wchar_t *host, const wchar_t *path, const std::string &body,
+                           const std::string &authorization, const std::string &signature, std::string *key )
+{
+    std::wstring headers = L"Content-Type: application/json\r\nAccept: application/json\r\nAuthorization: " +
+                           Widen( authorization ) + L"\r\n";
+    Ref<IJsonObject> object;
+    std::string response;
+    DWORD status = 0;
+    HRESULT hr;
+
+    if ( !signature.empty() ) headers += L"Signature: " + Widen( signature ) + L"\r\n";
+    if ( FAILED( hr = HttpRequest( L"POST", host, path, headers, body, &status, &response ) ) ) return hr;
+    if ( status != 200 )
+    {
+        WARN( "Store ID key from %s: HTTP %lu.\n", Narrow( host ).c_str(), status );
+        return status == 401 || status == 403 ? E_ACCESSDENIED : E_GAMESTORE_SERVER_ERROR;
+    }
+    if ( FAILED( hr = ParseObject( response, &object ) ) ) return hr;
+    return GetString( object.get(), L"key", key );
+}
+
 HRESULT SignRequest( const ProofKey &key, const SignaturePolicy &policy, const char *method,
                      const std::string &pathAndQuery, const std::string &authorization,
                      const HttpHeaders &headers, const BYTE *body, SIZE_T bodySize, std::string *signature )
