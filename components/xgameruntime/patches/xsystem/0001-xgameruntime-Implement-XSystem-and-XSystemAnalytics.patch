+#include "../test_fixtures.h"
+
+#include <cstring>
+#include <windows.h>
+#include <xsystem.h>
+
+class XSystemTests : public XGameRuntimeTests
+{
+};
+
+TEST_F(XSystemTests, ConsoleIdIsTheWindowsOne)
+{
+    char id[64];
+    SIZE_T used = 0;
+
+    EXPECT_HRESULT_SUCCEEDED(XSystemGetConsoleId(sizeof(id), id, &used));
+    EXPECT_STREQ(id, "00000000.00000000.00000000.00000000.00");
+    EXPECT_EQ(used, 39u);
+    EXPECT_EQ(XSystemGetConsoleId(10, id, &used), HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER));
+}
+
+TEST_F(XSystemTests, SandboxIsRetail)
+{
+    char id[16];
+    SIZE_T used = 0;
+
+    EXPECT_HRESULT_SUCCEEDED(XSystemGetXboxLiveSandboxId(sizeof(id), id, &used));
+    EXPECT_STREQ(id, "RETAIL");
+    EXPECT_EQ(used, 7u);
+}
+
+TEST_F(XSystemTests, AppSpecificDeviceIdIsStableBase64)
+{
+    char first[45], second[45];
+    SIZE_T used = 0;
+
+    EXPECT_HRESULT_SUCCEEDED(XSystemGetAppSpecificDeviceId(sizeof(first), first, &used));
+    EXPECT_EQ(used, 45u);
+    EXPECT_EQ(std::strlen(first), 44u);
+    EXPECT_EQ(std::strspn(first, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"), 43u);
+    EXPECT_EQ(first[43], '=');
+    EXPECT_HRESULT_SUCCEEDED(XSystemGetAppSpecificDeviceId(sizeof(second), second, nullptr));
+    EXPECT_STREQ(first, second);
+    EXPECT_EQ(XSystemGetAppSpecificDeviceId(44, first, &used), HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER));
+}
+
+TEST_F(XSystemTests, AnalyticsInfoIsAWindowsDesktop)
+{
+    XSystemAnalyticsInfo info = XSystemGetAnalyticsInfo();
+
+    EXPECT_STREQ(info.family, "Windows");
+    EXPECT_STREQ(info.form, "Desktop");
+    EXPECT_EQ(info.osVersion.major, 10);
+    EXPECT_GT(info.osVersion.build, 10000);
+    EXPECT_EQ(info.hostingOsVersion.build, info.osVersion.build);
+}
