+using namespace ABI::Windows::System::Profile;
+
+static const INT32 XSystemConsoleIdBytes = 39;
+static const INT32 XSystemXboxLiveSandboxIdMaxBytes = 16;
+static const INT32 XSystemAppSpecificDeviceIdBytes = 45;
+
+/* Copy text and its terminating NUL into buffer, as the XSystem getters do. */
+static HRESULT CopyId( const char *text, INT32 size, char *buffer, SIZE_T *used )
+{
+    SIZE_T length = strlen( text ) + 1;
+
+    if ( !buffer ) return E_POINTER;
+    if ( size < 0 || (SIZE_T)size < length ) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    memcpy( buffer, text, length );
+    if ( used ) *used = length;
+    return S_OK;
+}
+
+/* A per-device, per-title identifier: base64 of SHA-256 over the Wine prefix's MachineGuid and
+ * the title id, 44 characters. Stable for a title on a device (here, a prefix); titles cannot
+ * derive one another's. */
+static HRESULT MakeAppSpecificDeviceId( char id[XSystemAppSpecificDeviceIdBytes] )
+{
+    char machine[64], input[96];
+    DWORD size = sizeof(machine), length = XSystemAppSpecificDeviceIdBytes;
+    UCHAR digest[32];
+    LSTATUS error;
+    NTSTATUS status;
+
+    error = RegGetValueA( HKEY_LOCAL_MACHINE, "Software\\Microsoft\\Cryptography", "MachineGuid",
+                          RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, nullptr, machine, &size );
+    if ( error ) return HRESULT_FROM_WIN32( error );
+    snprintf( input, sizeof(input), "%s:%08X", machine, GetGameConfig().titleId );
+
+    status = BCryptHash( BCRYPT_SHA256_ALG_HANDLE, nullptr, 0, (PUCHAR)input, (ULONG)strlen( input ),
+                         digest, sizeof(digest) );
+    if ( !BCRYPT_SUCCESS( status ) ) return HRESULT_FROM_NT( status );
+    if ( !CryptBinaryToStringA( digest, sizeof(digest), CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, id, &length ) )
+        return HRESULT_FROM_WIN32( GetLastError() );
+    return S_OK;
+}
+
+class XSystemImpl :
+    public IXSystemImpl5
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXSystemImpl ) ||
+             iid == __uuidof( IXSystemImpl2 ) ||
+             iid == __uuidof( IXSystemImpl3 ) ||
+             iid == __uuidof( IXSystemImpl4 ) ||
+             iid == __uuidof( IXSystemImpl5 ) )
+        {
+            AddRef();
+            *out = static_cast<IXSystemImpl5 *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override
+    {
+        return static_cast<ULONG>(++ref);
+    }
+
+    ULONG WINAPI Release() noexcept override
+    {
+        // A static object: never deleted.
+        return static_cast<ULONG>(--ref);
+    }
+
+    HRESULT WINAPI XSystemGetConsoleId( INT32 consoleIdSize, char *consoleId, SIZE_T *consoleIdUsed ) override
+    {
+        TRACE( "consoleIdSize %d, consoleId %p, consoleIdUsed %p.\n", consoleIdSize, consoleId, consoleIdUsed );
+        return CopyId( "00000000.00000000.00000000.00000000.00", consoleIdSize, consoleId, consoleIdUsed );
+    }
+
+    HRESULT WINAPI XSystemGetXboxLiveSandboxId( INT32 sandboxIdSize, char *sandboxId, SIZE_T *sandboxIdUsed ) override
+    {
+        TRACE( "sandboxIdSize %d, sandboxId %p, sandboxIdUsed %p.\n", sandboxIdSize, sandboxId, sandboxIdUsed );
+        if ( sandboxIdSize < XSystemXboxLiveSandboxIdMaxBytes && sandboxId )
+            return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        return CopyId( "RETAIL", sandboxIdSize, sandboxId, sandboxIdUsed );
+    }
+
+    HRESULT WINAPI XSystemGetAppSpecificDeviceId( INT32 appSpecificDeviceIdSize, char *appSpecificDeviceId,
+                                                  SIZE_T *appSpecificDeviceIdUsed ) override
+    {
+        char id[XSystemAppSpecificDeviceIdBytes];
+        HRESULT hr;
+
+        TRACE( "appSpecificDeviceIdSize %d, appSpecificDeviceId %p, appSpecificDeviceIdUsed %p.\n",
+               appSpecificDeviceIdSize, appSpecificDeviceId, appSpecificDeviceIdUsed );
+
+        if ( !appSpecificDeviceId ) return E_POINTER;
+        if ( appSpecificDeviceIdSize < XSystemAppSpecificDeviceIdBytes )
+            return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        if ( FAILED( hr = MakeAppSpecificDeviceId( id ) ) )
+        {
+            ERR( "cannot derive the app-specific device id, hr %#lx.\n", hr );
+            return hr;
+        }
+        return CopyId( id, appSpecificDeviceIdSize, appSpecificDeviceId, appSpecificDeviceIdUsed );
+    }
+
+    HRESULT WINAPI XSystemHandleTrack( XSystemHandleCallback callback, void *context ) override
+    {
+        FIXME( "callback %p, context %p stub!\n", callback, context );
+        return E_NOTIMPL;
+    }
+
+    BOOLEAN WINAPI XSystemIsHandleValid( XSystemHandle handle ) override
+    {
+        FIXME( "handle %p stub!\n", handle );
+        return FALSE;
+    }
+
+    void WINAPI XSystemAllowFullDownloadBandwidth( BOOLEAN enable ) override
+    {
+        FIXME( "enable %u stub!\n", enable );
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+/* Fill info from Windows.System.Profile.AnalyticsInfo; false when WinRT cannot answer. */
+static bool AnalyticsFromWinRT( XSystemAnalyticsInfo *info )
+{
+    IAnalyticsInfoStatics *statics = nullptr;
+    IAnalyticsVersionInfo *version = nullptr;
+    HSTRING name = nullptr, family = nullptr, familyVersion = nullptr;
+    char text[128], *dot;
+    bool ok = false;
+
+    if ( FAILED( WindowsCreateString( RuntimeClass_Windows_System_Profile_AnalyticsInfo,
+                                      lstrlenW( RuntimeClass_Windows_System_Profile_AnalyticsInfo ), &name ) ) )
+        return false;
+    if ( SUCCEEDED( RoGetActivationFactory( name, __uuidof( IAnalyticsInfoStatics ), (void **)&statics ) ) &&
+         SUCCEEDED( statics->get_VersionInfo( &version ) ) &&
+         SUCCEEDED( version->get_DeviceFamily( &family ) ) &&
+         SUCCEEDED( version->get_DeviceFamilyVersion( &familyVersion ) ) )
+    {
+        /* DeviceFamily is "<family>.<form>", e.g. "Windows.Desktop". */
+        WideCharToMultiByte( CP_UTF8, 0, WindowsGetStringRawBuffer( family, nullptr ), -1, text, sizeof(text),
+                             nullptr, nullptr );
+        if ( ( dot = strchr( text, '.' ) ) )
+        {
+            *dot = '\0';
+            lstrcpynA( info->family, text, sizeof(info->family) );
+            lstrcpynA( info->form, dot + 1, sizeof(info->form) );
+        }
+        /* DeviceFamilyVersion is a decimal 64-bit number, 16 bits per version part. */
+        WideCharToMultiByte( CP_UTF8, 0, WindowsGetStringRawBuffer( familyVersion, nullptr ), -1, text,
+                             sizeof(text), nullptr, nullptr );
+        ULONGLONG packed = strtoull( text, nullptr, 10 );
+        if ( packed && dot )
+        {
+            info->osVersion.major = (UINT16)( packed >> 48 );
+            info->osVersion.minor = (UINT16)( ( packed >> 32 ) & 0xffff );
+            info->osVersion.build = (UINT16)( ( packed >> 16 ) & 0xffff );
+            info->osVersion.revision = (UINT16)( packed & 0xffff );
+            info->hostingOsVersion = info->osVersion;
+            ok = true;
+        }
+    }
+    WindowsDeleteString( familyVersion );
+    WindowsDeleteString( family );
+    WindowsDeleteString( name );
+    if ( version ) version->Release();
+    if ( statics ) statics->Release();
+    return ok;
+}
+
+class XSystemAnalyticsImpl :
+    public IXSystemAnalyticsImpl
+{
+public:
+    HRESULT WINAPI QueryInterface( REFIID iid, void **out ) noexcept override
+    {
+        TRACE( "iface %p, iid %s, out %p.\n", this, debugstr_guid( &iid ), out );
+
+        if ( !out ) return E_POINTER;
+        *out = nullptr;
+
+        if ( iid == __uuidof( IUnknown ) ||
+             iid == __uuidof( IXSystemAnalyticsImpl ) )
+        {
+            AddRef();
+            *out = static_cast<IXSystemAnalyticsImpl *>(this);
+            return S_OK;
+        }
+
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &iid ) );
+        return E_NOINTERFACE;
+    }
+
+    ULONG WINAPI AddRef() noexcept override
+    {
+        return static_cast<ULONG>(++ref);
+    }
+
+    ULONG WINAPI Release() noexcept override
+    {
+        // A static object: never deleted.
+        return static_cast<ULONG>(--ref);
+    }
+
+    /* Returned through a hidden pointer after this, as MSVC-built games expect
+     * (WIDL_EXPLICIT_AGGREGATE_RETURNS). */
+    XSystemAnalyticsInfo *WINAPI XSystemGetAnalyticsInfo( XSystemAnalyticsInfo *__ret ) override
+    {
+        XSystemAnalyticsInfo info{};
+
+        TRACE( "iface %p, __ret %p.\n", this, __ret );
+
+        if ( !AnalyticsFromWinRT( &info ) )
+        {
+            /* What a current Windows 10 desktop reports; the game must always get an answer. */
+            WARN( "Windows.System.Profile.AnalyticsInfo unavailable, reporting Windows.Desktop 10.0.19045.\n" );
+            info = XSystemAnalyticsInfo{};
+            info.osVersion.major = 10;
+            info.osVersion.minor = 0;
+            info.osVersion.build = 19045;
+            info.osVersion.revision = 0;
+            info.hostingOsVersion = info.osVersion;
+            lstrcpynA( info.family, "Windows", sizeof(info.family) );
+            lstrcpynA( info.form, "Desktop", sizeof(info.form) );
+        }
+        *__ret = info;
+        return __ret;
+    }
+
+private:
+    std::atomic_long ref{ 1 };
+};
+
+static XSystemImpl g_x_system;
+static XSystemAnalyticsImpl g_x_system_analytics;
+
+IXSystemImpl5 *x_system = static_cast<IXSystemImpl5 *>(&g_x_system);
+IXSystemAnalyticsImpl *x_system_analytics = static_cast<IXSystemAnalyticsImpl *>(&g_x_system_analytics);
