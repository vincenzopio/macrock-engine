diff --git a/tests/System/test_nsal.cpp b/tests/System/test_nsal.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0431066671804002acbe88d9a56c1a1f50e58319
--- /dev/null
+++ b/tests/System/test_nsal.cpp
@@ -0,0 +1,187 @@
+/*
+ * Tests for the NSAL and request signing (src/System/Nsal.cpp, built into the tests)
+ *
+ * Copyright 2026 vincenzopio (macrock)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <gtest/gtest.h>
+
+#include "../../src/System/Nsal.h"
+
+using namespace XboxLive;
+
+static NsalEndpoint Endpoint( const char *protocol, const char *host, const char *path, const char *relyingParty,
+                              INT32 policy = -1 )
+{
+    NsalEndpoint endpoint;
+    endpoint.protocol = protocol;
+    endpoint.wildcard = host[0] == '*';
+    endpoint.host = endpoint.wildcard ? host + 1 : host;
+    endpoint.path = path;
+    endpoint.relyingParty = relyingParty;
+    endpoint.tokenType = "JWT";
+    endpoint.signaturePolicy = policy;
+    return endpoint;
+}
+
+/* The shape of the default NSAL (title.mgt.xboxlive.com/titles/default/endpoints?type=1). */
+static Nsal DefaultLike()
+{
+    Nsal nsal;
+    nsal.policies.resize( 2 );
+    nsal.endpoints = {
+        Endpoint( "https", "*.xboxlive.com", "", "http://xboxlive.com", 0 ),
+        Endpoint( "http", "*.xboxlive.com", "", "" ),
+        Endpoint( "https", "*.ui.xboxlive.com", "", "" ),
+        Endpoint( "https", "privileges.xboxlive.com", "/upsell", "http://upsell.example", 1 ),
+        Endpoint( "https", "playfabapi.com", "", "http://playfab.xboxlive.com/" ),
+    };
+    return nsal;
+}
+
+static std::string RelyingPartyFor( const Nsal &nsal, const char *text )
+{
+    Url url;
+    if ( !ParseUrl( text, &url ) ) return "(bad url)";
+    const NsalEndpoint *endpoint = nsal.Find( url );
+    return endpoint ? endpoint->relyingParty : "(none)";
+}
+
+TEST(NsalTests, ParsesUrls)
+{
+    Url url;
+
+    ASSERT_TRUE(ParseUrl("HTTPS://Title.MGT.xboxlive.com:443/titles/1/endpoints?type=1", &url));
+    EXPECT_EQ(url.scheme, "https");
+    EXPECT_EQ(url.host, "title.mgt.xboxlive.com");
+    EXPECT_EQ(url.pathAndQuery, "/titles/1/endpoints?type=1");
+
+    ASSERT_TRUE(ParseUrl("https://playfabapi.com", &url));
+    EXPECT_EQ(url.pathAndQuery, "/");
+    ASSERT_TRUE(ParseUrl("https://user:secret@example.com?q=1", &url));
+    EXPECT_EQ(url.host, "example.com");
+    EXPECT_EQ(url.pathAndQuery, "/?q=1");
+
+    EXPECT_FALSE(ParseUrl("example.com/?u=http://example.org", &url));
+    EXPECT_FALSE(ParseUrl("https:///path", &url));
+    EXPECT_FALSE(ParseUrl(nullptr, &url));
+}
+
+TEST(NsalTests, FindsTheMostSpecificEndpoint)
+{
+    Nsal nsal = DefaultLike();
+
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://profile.xboxlive.com/users/me"), "http://xboxlive.com");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://a.b.xboxlive.com/"), "http://xboxlive.com");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://PRIVILEGES.xboxlive.com/upsell?x=1"), "http://upsell.example");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://privileges.xboxlive.com/upsell/more"), "http://upsell.example");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://privileges.xboxlive.com/upsells"), "http://xboxlive.com");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://playfabapi.com/"), "http://playfab.xboxlive.com/");
+}
+
+TEST(NsalTests, WebSocketsMatchTheirHttpProtocol)
+{
+    Nsal nsal = DefaultLike();
+
+    // XSAPI's real-time activity service.
+    EXPECT_EQ(RelyingPartyFor(nsal, "wss://rta.xboxlive.com/connect"), "http://xboxlive.com");
+    EXPECT_EQ(RelyingPartyFor(nsal, "ws://rta.xboxlive.com/connect"), "");
+}
+
+TEST(NsalTests, GivesNoTokenOutsideTheList)
+{
+    Nsal nsal = DefaultLike();
+
+    // Entries without a relying party exclude what they match.
+    EXPECT_EQ(RelyingPartyFor(nsal, "http://profile.xboxlive.com/users/me"), "");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://help.ui.xboxlive.com/"), "");
+    // Hosts the list does not name.
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://xboxlive.com/"), "(none)");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://xboxlive.com.example.org/"), "(none)");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://20ca2.playfabapi.com/"), "(none)");
+    EXPECT_EQ(RelyingPartyFor(nsal, "https://example.com/"), "(none)");
+}
+
+TEST(NsalTests, CatchAllExcludesOnlyWhatNothingElseMatches)
+{
+    Nsal title, defaults = DefaultLike();
+
+    // A title's list ends with "https://*" and "http://*", without a relying party.
+    title.endpoints = { Endpoint( "https", "multiplayer.example.net", "", "https://multiplayer.example.net/" ),
+                        Endpoint( "https", "*", "", "" ), Endpoint( "http", "*", "", "" ) };
+    title.Append( defaults );
+
+    EXPECT_EQ(RelyingPartyFor(title, "https://multiplayer.example.net/session"), "https://multiplayer.example.net/");
+    EXPECT_EQ(RelyingPartyFor(title, "https://profile.xboxlive.com/users/me"), "http://xboxlive.com");
+    EXPECT_EQ(RelyingPartyFor(title, "https://example.com/"), "");
+}
+
+TEST(NsalTests, AppendedEntriesComeSecondAndKeepTheirPolicies)
+{
+    Nsal title, defaults = DefaultLike();
+    Url url;
+
+    title.policies.resize( 1 );
+    title.policies[0].version = 7;
+    title.endpoints = { Endpoint( "https", "*.xboxlive.com", "", "rp://title/", 0 ) };
+    title.Append( defaults );
+
+    ASSERT_EQ(title.policies.size(), 3u);
+    EXPECT_EQ(RelyingPartyFor(title, "https://profile.xboxlive.com/"), "rp://title/");
+    ASSERT_TRUE(ParseUrl("https://privileges.xboxlive.com/upsell", &url));
+    const NsalEndpoint *endpoint = title.Find( url );
+    ASSERT_NE(endpoint, nullptr);
+    EXPECT_EQ(endpoint->signaturePolicy, 2); // its policy 1, after the title's one
+    EXPECT_EQ(title.policies[0].version, 7u);
+}
+
+TEST(NsalTests, SignsTheDocumentedBytes)
+{
+    SignaturePolicy policy;
+    HttpHeaders headers = { { "x-extra", "v" } };
+    const BYTE body[] = "0123456789";
+
+    policy.version = 1;
+    policy.maxBodyBytes = 8;
+    policy.extraHeaders = { "X-Extra", "Missing" };
+    std::string payload = SigningPayload( policy, 0x0102030405060708ull, "post", "/p?q=1", "XBL3.0 x=h;t", headers,
+                                          body, 10 );
+
+    std::string expected( "\x00\x00\x00\x01\x00" "\x01\x02\x03\x04\x05\x06\x07\x08\x00" "POST\x00" "/p?q=1\x00"
+                          "XBL3.0 x=h;t\x00" "v\x00" "\x00" "01234567\x00", 5 + 9 + 5 + 7 + 13 + 2 + 1 + 9 );
+    EXPECT_EQ(payload, expected);
+
+    // No extra headers and no body: the body's NUL is still there.
+    policy.extraHeaders.clear();
+    payload = SigningPayload( policy, 0, "GET", "/", "a", headers, nullptr, 0 );
+    EXPECT_EQ(payload, std::string( "\x00\x00\x00\x01\x00" "\x00\x00\x00\x00\x00\x00\x00\x00\x00" "GET\x00" "/\x00" "a\x00" "\x00",
+                                    5 + 9 + 4 + 2 + 2 + 1 ));
+}
+
+TEST(NsalTests, EncodesTheSignatureHeader)
+{
+    BYTE signature[64] = {};
+
+    std::string header = SignatureHeader( 1, 0, signature );
+    EXPECT_EQ(header.size(), 104u);              // 76 bytes
+    EXPECT_EQ(header.substr( 0, 6 ), "AAAAAQ"); // version 1, big-endian
+
+    EXPECT_EQ(Base64( reinterpret_cast<const BYTE *>("f"), 1 ), "Zg==");
+    EXPECT_EQ(Base64( reinterpret_cast<const BYTE *>("fo"), 2 ), "Zm8=");
+    EXPECT_EQ(Base64( reinterpret_cast<const BYTE *>("foo"), 3 ), "Zm9v");
+    EXPECT_EQ(Base64( reinterpret_cast<const BYTE *>("\xfb\xff"), 2 ), "+/8=");
+}
