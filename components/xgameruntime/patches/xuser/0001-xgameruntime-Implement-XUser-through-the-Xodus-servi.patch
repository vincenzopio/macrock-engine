+static const char addIdentity[] = "XUserAddAsync";
+
+struct AddContext
+{
+    XUserAddOptions options;
+    XUser *user = nullptr;
+};
+
+static HRESULT CALLBACK AddProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    auto *context = static_cast<AddContext *>(data->context);
+
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+        {
+            /* One sign-in at a time; later additions get the signed-in user. */
+            const std::lock_guard<std::mutex> lock( usersLock );
+            HRESULT hr = S_OK;
+
+            if ( !signedInUser )
+            {
+                BOOLEAN allowUI = !( static_cast<UINT32>(context->options) &
+                                     static_cast<UINT32>(XUserAddOptions::AddDefaultUserSilently) );
+                hr = SignIn( allowUI, &signedInUser );
+            }
+            if ( SUCCEEDED( hr ) )
+            {
+                AddRef( signedInUser );
+                context->user = signedInUser;
+            }
+            XAsyncComplete( data->async, hr, SUCCEEDED( hr ) ? sizeof(XUserHandle) : 0 );
+            return S_OK;
+        }
+
+        case XAsyncOp::GetResult:
+            *static_cast<XUserHandle *>(data->buffer) = context->user;
+            context->user = nullptr; /* the caller owns it now */
+            return S_OK;
+
+        case XAsyncOp::Cleanup:
+            if ( context->user ) Release( context->user );
+            delete context;
+            return S_OK;
+
+        default:
+            return S_OK;
+    }
+}
