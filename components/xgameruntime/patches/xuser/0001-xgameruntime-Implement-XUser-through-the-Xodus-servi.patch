+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "Nsal.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+namespace XboxLive
+{
+
+static char LowerAscii( char c ) { return c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c; }
+
+std::string Lower( std::string text )
+{
+    for ( char &c : text ) c = LowerAscii( c );
+    return text;
+}
+
+static BOOL EqualNoCase( const std::string &a, const std::string &b )
+{
+    return a.size() == b.size() && std::equal( a.begin(), a.end(), b.begin(),
+                                               []( char x, char y ) { return LowerAscii( x ) == LowerAscii( y ); } );
+}
+
+BOOL ParseUrl( const char *url, Url *out )
+{
+    const char *schemeEnd, *authority, *end, *host, *portSeparator, *p;
+
+    if ( !url || !( schemeEnd = strstr( url, "://" ) ) || schemeEnd == url ) return FALSE;
+    for ( p = url; p < schemeEnd; ++p )
+        if ( !isalnum( (unsigned char)*p ) && *p != '+' && *p != '-' && *p != '.' ) return FALSE;
+
+    authority = schemeEnd + 3;
+    end = authority + strcspn( authority, "/?#" );
+    host = authority;
+    for ( p = authority; p < end; ++p )
+        if ( *p == '@' ) host = p + 1; /* user information */
+
+    portSeparator = end;
+    if ( *host == '[' ) /* an IPv6 address */
+    {
+        const char *close = static_cast<const char *>(memchr( host, ']', end - host ));
+        if ( close && close + 1 < end && close[1] == ':' ) portSeparator = close + 1;
+    }
+    else if ( ( p = static_cast<const char *>(memchr( host, ':', end - host )) ) ) portSeparator = p;
+    if ( portSeparator == host ) return FALSE;
+
+    out->scheme = Lower( std::string( url, schemeEnd ) );
+    out->host = Lower( std::string( host, portSeparator ) );
+    out->pathAndQuery = *end == '/' ? std::string( end ) : "/" + std::string( end );
+    return TRUE;
+}
+
+static BOOL HostMatches( const NsalEndpoint &endpoint, const std::string &host )
+{
+    if ( !endpoint.wildcard ) return host == endpoint.host;
+    return host.size() > endpoint.host.size() &&
+           !host.compare( host.size() - endpoint.host.size(), endpoint.host.size(), endpoint.host );
+}
+
+/* A path prefix matches whole segments: "/upsell" matches "/upsell/x" and "/upsell?x", not "/upsells". */
+static BOOL PathMatches( const std::string &prefix, const std::string &pathAndQuery )
+{
+    if ( prefix.empty() ) return TRUE;
+    if ( pathAndQuery.size() < prefix.size() || !EqualNoCase( pathAndQuery.substr( 0, prefix.size() ), prefix ) )
+        return FALSE;
+    if ( prefix.back() == '/' || pathAndQuery.size() == prefix.size() ) return TRUE;
+    return strchr( "/?#", pathAndQuery[prefix.size()] ) != nullptr;
+}
+
+const NsalEndpoint *Nsal::Find( const Url &url ) const
+{
+    const NsalEndpoint *best = nullptr;
+    SIZE_T bestScore[3] = { 0, 0, 0 };
+    /* The list names HTTP protocols only; WebSockets (XSAPI's real-time activity) open as such. */
+    const std::string protocol = url.scheme == "wss" ? "https" : url.scheme == "ws" ? "http" : url.scheme;
+
+    for ( const NsalEndpoint &endpoint : endpoints )
+    {
+        if ( endpoint.protocol != protocol || !HostMatches( endpoint, url.host ) ||
+             !PathMatches( endpoint.path, url.pathAndQuery ) )
+            continue;
+
+        SIZE_T score[3] = { endpoint.wildcard ? 1u : 2u, endpoint.host.size(), endpoint.path.size() };
+        if ( std::lexicographical_compare( bestScore, bestScore + 3, score, score + 3 ) )
+        {
+            best = &endpoint;
+            std::copy( score, score + 3, bestScore );
+        }
+    }
+    return best;
+}
+
+void Nsal::Append( const Nsal &other )
+{
+    INT32 offset = static_cast<INT32>(policies.size());
+
+    policies.insert( policies.end(), other.policies.begin(), other.policies.end() );
+    for ( NsalEndpoint endpoint : other.endpoints )
+    {
+        if ( endpoint.signaturePolicy >= 0 ) endpoint.signaturePolicy += offset;
+        endpoints.push_back( std::move( endpoint ) );
+    }
+}
+
+static void PutBigEndian( std::string *out, UINT64 value, int bytes )
+{
+    for ( int i = bytes - 1; i >= 0; --i ) *out += static_cast<char>( ( value >> ( 8 * i ) ) & 0xff );
+}
+
+std::string SigningPayload( const SignaturePolicy &policy, UINT64 timestamp, const char *method,
+                            const std::string &pathAndQuery, const std::string &authorization,
+                            const HttpHeaders &headers, const BYTE *body, SIZE_T bodySize )
+{
+    std::string payload;
+
+    PutBigEndian( &payload, policy.version, 4 );
+    payload += '\0';
+    PutBigEndian( &payload, timestamp, 8 );
+    payload += '\0';
+    for ( const char *c = method; *c; ++c ) payload += static_cast<char>( toupper( (unsigned char)*c ) );
+    payload += '\0';
+    payload += pathAndQuery;
+    payload += '\0';
+    payload += authorization;
+    payload += '\0';
+    /* A header the request lacks is signed as an empty value. */
+    for ( const std::string &name : policy.extraHeaders )
+    {
+        auto header = std::find_if( headers.begin(), headers.end(),
+                                    [&name]( const auto &h ) { return EqualNoCase( h.first, name ); } );
+        if ( header != headers.end() ) payload += header->second;
+        payload += '\0';
+    }
+    payload.append( reinterpret_cast<const char *>(body),
+                    static_cast<SIZE_T>( std::min<UINT64>( bodySize, policy.maxBodyBytes ) ) );
+    payload += '\0';
+    return payload;
+}
+
+std::string SignatureHeader( UINT32 version, UINT64 timestamp, const BYTE signature[64] )
+{
+    std::string raw;
+
+    PutBigEndian( &raw, version, 4 );
+    PutBigEndian( &raw, timestamp, 8 );
+    raw.append( reinterpret_cast<const char *>(signature), 64 );
+    return Base64( reinterpret_cast<const BYTE *>(raw.data()), raw.size() );
+}
+
+std::string Base64( const BYTE *data, SIZE_T size, BOOL url )
+{
+    const char *alphabet = url ? "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
+                               : "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    SIZE_T i;
+
+    for ( i = 0; i + 2 < size; i += 3 )
+    {
+        UINT32 v = data[i] << 16 | data[i + 1] << 8 | data[i + 2];
+        out += alphabet[v >> 18]; out += alphabet[(v >> 12) & 63]; out += alphabet[(v >> 6) & 63]; out += alphabet[v & 63];
+    }
+    if ( size - i == 1 )
+    {
+        UINT32 v = data[i] << 16;
+        out += alphabet[v >> 18]; out += alphabet[(v >> 12) & 63];
+        if ( !url ) out += "==";
+    }
+    else if ( size - i == 2 )
+    {
+        UINT32 v = data[i] << 16 | data[i + 1] << 8;
+        out += alphabet[v >> 18]; out += alphabet[(v >> 12) & 63]; out += alphabet[(v >> 6) & 63];
+        if ( !url ) out += '=';
+    }
+    return out;
+}
+
+}
diff --git a/src/System/Nsal.h b/src/System/Nsal.h
new file mode 100644
index 0000000000000000000000000000000000000000..15f7d7e7dd82359a6c877d6c582fe6627ac078ee
--- /dev/null
+++ b/src/System/Nsal.h
@@ -0,0 +1,103 @@
+/*
+ * Xbox Game runtime Library
+ *  Network security authorization list (NSAL) and request signing
+ *
+ * The NSAL tells which relying party a request needs an Xbox Live token for, if any, and how
+ * the request is signed. Signatures follow "Title service calls to Xbox services" (Microsoft
+ * Game Development Kit documentation, "Proof keys"). Plain C++ with no runtime dependencies, so
+ * that the tests build it too.
+ *
+ * Copyright 2026 vincenzopio (macrock)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __XGAMERUNTIME_NSAL_H__
+#define __XGAMERUNTIME_NSAL_H__
+
+#include <windows.h>
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace XboxLive
+{
+
+/* What token requests depend on in a URL. */
+struct Url
+{
+    std::string scheme;       /* lowercase */
+    std::string host;         /* lowercase, without user information and port */
+    std::string pathAndQuery; /* everything from the path on; "/" when the URL has no path */
+};
+
+/* FALSE when the URL has no scheme or no host. */
+BOOL ParseUrl( const char *url, Url *out );
+
+struct SignaturePolicy
+{
+    UINT32 version = 0;
+    UINT64 maxBodyBytes = 0;
+    BOOL es256 = FALSE;                    /* among its SupportedAlgorithms */
+    std::vector<std::string> extraHeaders; /* signed in this order */
+};
+
+struct NsalEndpoint
+{
+    std::string protocol;       /* lowercase */
+    std::string host;           /* lowercase; for a wildcard, the part after "*" (".xboxlive.com") */
+    BOOL wildcard = FALSE;
+    std::string path;           /* empty: any path */
+    std::string relyingParty;   /* empty: requests to it carry no token */
+    std::string tokenType;
+    INT32 signaturePolicy = -1; /* index in Nsal::policies; -1: requests to it are not signed */
+};
+
+struct Nsal
+{
+    std::vector<NsalEndpoint> endpoints;
+    std::vector<SignaturePolicy> policies;
+
+    /* The endpoint that most specifically matches a URL: a host before a wildcard, a longer
+     * wildcard before a shorter one, then the longest path. The first one wins a tie. WebSocket
+     * URLs match the entries of their HTTP protocol (wss of https, ws of http). */
+    const NsalEndpoint *Find( const Url &url ) const;
+
+    /* Append the endpoints of another list, which come after these in a tie. */
+    void Append( const Nsal &other );
+};
+
+typedef std::vector<std::pair<std::string, std::string>> HttpHeaders;
+
+/* The bytes a version 1 signature covers: version, timestamp (a FILETIME), method, path and
+ * query, Authorization header, the policy's extra headers and up to maxBodyBytes of the body,
+ * each followed by a NUL. */
+std::string SigningPayload( const SignaturePolicy &policy, UINT64 timestamp, const char *method,
+                            const std::string &pathAndQuery, const std::string &authorization,
+                            const HttpHeaders &headers, const BYTE *body, SIZE_T bodySize );
+
+/* The Signature header: base64 of the version, the timestamp and the 64-byte signature. */
+std::string SignatureHeader( UINT32 version, UINT64 timestamp, const BYTE signature[64] );
+
+/* Base64; with url, the URL-safe alphabet without padding. */
+std::string Base64( const BYTE *data, SIZE_T size, BOOL url = FALSE );
+
+/* ASCII lowercase. */
+std::string Lower( std::string text );
+
+}
+
+#endif
diff --git a/src/System/XUser.cpp b/src/System/XUser.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c2ebccd31dba793e25e2c98e99a17322c07ee3ee
--- /dev/null
+++ b/src/System/XUser.cpp
@@ -0,0 +1,945 @@
+/*
+ * Xbox Game runtime Library
+ *  GDK Component: System API -> XUser (sign-in, identity, tokens)
+ *
+ * Sign-in takes the Xodus service's MSA tickets to Xbox Live as Win32 titles do (SISU: device,
+ * title, user and XSTS tokens bound to a proof key); the identity comes from the XSTS claims, and
+ * tokens for other services follow the NSAL.
+ *
+ * Copyright 2026 vincenzopio (macrock)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "../private.h"
+#include "../Xodus/Structs.hpp"
+#include "GameConfig.h"
+#include "XboxLive.h"
+
+#include <private/IXAsync.hpp>
+#include <winstring.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+using namespace ABI;
+using namespace ABI::Xodus;
+
+/* The user an XUserHandle points to. The handle is a counted reference to it. */
+struct XUser
+{
+    std::atomic_long ref{ 1 };
+    UINT64 localId = 0;
+    UINT64 xuid = 0;
+    std::string gamertag, modernGamertag, modernSuffix, uniqueModern;
+    XUserAgeGroup ageGroup = XUserAgeGroup::Unknown;
+    std::set<UINT32> privileges;
+
+    /* The key all of the user's XSTS tokens are bound to; set at sign-in, then only read. */
+    XboxLive::ProofKey proofKey;
+
+    /* Behind tokensLock: the user, device and title tokens and when the first of them expires,
+     * when a failed renewal may be tried again, XSTS tokens by relying party, and relying parties
+     * that recently refused one. */
+    std::mutex tokensLock;
+    std::string userToken, deviceToken, titleToken;
+    UINT64 userTokenNotAfter = 0, refreshRetryAfter = 0;
+    std::map<std::string, XboxLive::XstsToken> xsts;
+    std::map<std::string, UINT64> xstsRetryAfter;
+};
+
+static const UINT64 second = 10000000, minute = 60 * second; /* in FILETIME units */
+static const char xboxLiveRelyingParty[] = "http://xboxlive.com";
+
+static void AddRef( XUser *user ) { ++user->ref; }
+static void Release( XUser *user ) { if ( !--user->ref ) delete user; }
+
+/* PC titles have one user: whoever signed in through Xodus. */
+static std::mutex usersLock;
+static XUser *signedInUser;
+
+static XUserAgeGroup ParseAgeGroup( const std::string &claim )
+{
+    if ( claim == "Adult" ) return XUserAgeGroup::Adult;
+    if ( claim == "Teen" ) return XUserAgeGroup::Teen;
+    if ( claim == "Child" ) return XUserAgeGroup::Child;
+    return XUserAgeGroup::Unknown;
+}
+
+static std::set<UINT32> ParsePrivileges( const std::string &claim )
+{
+    std::set<UINT32> privileges;
+    const char *p = claim.c_str();
+    char *end;
+
+    for ( ;; )
+    {
+        unsigned long value = strtoul( p, &end, 10 );
+        if ( end == p ) break;
+        privileges.insert( (UINT32)value );
+        p = end;
+    }
+    return privileges;
+}
+
+/* RPS tickets for the title and for the device from the Xodus service (the Microsoft account it
+ * signed in). The device ticket may be empty. */
+static HRESULT RequestRpsTicket( BOOLEAN allowUI, std::string *ticket, std::string *deviceTicket )
+{
+    const GameConfig &config = GetGameConfig();
+    IXAsync<IMsaTokenResponse *> *operation = nullptr;
+    IMsaTokenResponse *response = nullptr;
+    HSTRING clientId = nullptr, token = nullptr, device = nullptr;
+    HRESULT hr;
+
+    if ( FAILED( config.status ) ) return config.status;
+    if ( !config.msaAppId[0] ) return E_GAMEUSER_NO_MSAAPPID;
+
+    std::wstring wideId = XboxLive::Widen( config.msaAppId );
+    if ( FAILED( hr = WindowsCreateString( wideId.c_str(), (UINT32)wideId.size(), &clientId ) ) ) return hr;
+    if ( SUCCEEDED( hr = xodus_service->MsaTokenRequest( clientId, allowUI, config.msaFullTrust, &operation ) ) &&
+         SUCCEEDED( hr = operation->GetResults( TRUE, &response ) ) &&
+         SUCCEEDED( hr = response->get_Token( &token ) ) &&
+         SUCCEEDED( hr = response->get_DeviceRps( &device ) ) )
+    {
+        *ticket = XboxLive::Narrow( token );
+        *deviceTicket = XboxLive::Narrow( device );
+        if ( ticket->empty() ) hr = E_GAMEUSER_NO_DEFAULT_USER; /* the service has no signed-in account */
+    }
+    WindowsDeleteString( device );
+    WindowsDeleteString( token );
+    WindowsDeleteString( clientId );
+    if ( response ) response->Release();
+    if ( operation ) operation->Release();
+    return hr;
+}
+
+static UINT64 Earliest( UINT64 a, UINT64 b ) { return !a ? b : !b ? a : std::min( a, b ); }
+
+/* Xbox Live tokens for the account the Xodus service signed in, bound to the user's proof key,
+ * through SISU as the GDK gets them: the device, title and user tokens, and the XSTS token for
+ * http://xboxlive.com. Called at sign-in, then with tokensLock held. */
+static HRESULT Authenticate( XUser *user, BOOLEAN allowUI, XboxLive::XstsToken *identity )
+{
+    std::string ticket, deviceTicket, deviceToken;
+    XboxLive::SisuTokens sisu;
+    UINT64 deviceNotAfter = 0;
+    HRESULT hr;
+
+    if ( FAILED( hr = RequestRpsTicket( allowUI, &ticket, &deviceTicket ) ) )
+    {
+        WARN( "no RPS ticket from the Xodus service, hr %#lx.\n", hr );
+        return hr;
+    }
+    if ( deviceTicket.empty() )
+    {
+        WARN( "no device ticket from the Xodus service.\n" );
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+    }
+    if ( FAILED( hr = XboxLive::RequestDeviceToken( deviceTicket, user->proofKey, &deviceToken, &deviceNotAfter ) ) ||
+         FAILED( hr = XboxLive::SisuAuthorize( ticket, GetGameConfig().msaAppId, deviceToken, user->proofKey,
+                                               &sisu ) ) )
+    {
+        WARN( "SISU sign-in failed, hr %#lx.\n", hr );
+        return hr;
+    }
+    user->userToken = sisu.userToken;
+    user->deviceToken = deviceToken;
+    user->titleToken = sisu.titleToken;
+    user->userTokenNotAfter = Earliest( Earliest( sisu.userNotAfter, sisu.titleNotAfter ), deviceNotAfter );
+    *identity = sisu.xsts;
+    return S_OK;
+}
+
+static HRESULT SignIn( BOOLEAN allowUI, XUser **out )
+{
+    static std::atomic<UINT64> nextLocalId{ 1 };
+    XboxLive::XstsToken identity;
+    HRESULT hr;
+
+    XUser *user = new XUser();
+    if ( FAILED( hr = user->proofKey.Generate() ) )
+        WARN( "proof key generation failed, hr %#lx.\n", hr );
+    else
+        hr = Authenticate( user, allowUI, &identity );
+    if ( FAILED( hr ) )
+    {
+        Release( user );
+        return hr;
+    }
+
+    user->localId = nextLocalId++;
+    user->xuid = identity.xuid;
+    user->gamertag = identity.gamertag;
+    user->modernGamertag = identity.modernGamertag;
+    user->modernSuffix = identity.modernSuffix;
+    user->uniqueModern = identity.uniqueModern;
+    user->ageGroup = ParseAgeGroup( identity.ageGroup );
+    user->privileges = ParsePrivileges( identity.privileges );
+    user->xsts[xboxLiveRelyingParty] = identity;
+    TRACE( "signed in: local id %llu, %zu privileges, age group %d.\n", (unsigned long long)user->localId,
+           user->privileges.size(), (int)user->ageGroup );
+    *out = user;
+    return S_OK;
+}
