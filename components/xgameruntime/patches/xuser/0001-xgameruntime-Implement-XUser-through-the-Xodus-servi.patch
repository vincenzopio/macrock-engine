+/* New user, device and title tokens from new RPS tickets. Called with tokensLock held. */
+static HRESULT RefreshUserToken( XUser *user )
+{
+    XboxLive::XstsToken identity;
+    HRESULT hr;
+
+    if ( FAILED( hr = Authenticate( user, FALSE, &identity ) ) ) return hr;
+    user->xsts[xboxLiveRelyingParty] = identity;
+    return S_OK;
+}
+
+/* An XSTS token for a relying party: from the cache while it has five more minutes, else a new
+ * one. A relying party that refused one, or a failed renewal of the user's tokens, is not tried
+ * again for a minute. */
+static HRESULT GetXsts( XUser *user, const std::string &relyingParty, BOOL forceRefresh, XboxLive::XstsToken *out )
+{
+    const std::lock_guard<std::mutex> lock( user->tokensLock );
+    UINT64 now = XboxLive::Now();
+    DWORD status = 0;
+    HRESULT hr;
+
+    auto cached = user->xsts.find( relyingParty );
+    if ( !forceRefresh && cached != user->xsts.end() && cached->second.notAfter > now + 5 * minute )
+    {
+        *out = cached->second;
+        return S_OK;
+    }
+    auto refused = user->xstsRetryAfter.find( relyingParty );
+    if ( !forceRefresh && refused != user->xstsRetryAfter.end() && refused->second > now )
+        return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+
+    if ( user->userTokenNotAfter <= now + 5 * minute )
+    {
+        if ( user->refreshRetryAfter > now ) return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+        if ( FAILED( hr = RefreshUserToken( user ) ) )
+        {
+            user->refreshRetryAfter = now + minute;
+            return hr;
+        }
+    }
+    hr = XboxLive::RequestXstsToken( user->userToken, user->proofKey, relyingParty.c_str(), out, &status,
+                                     user->deviceToken, user->titleToken );
+    /* 401: a token expired or was revoked early. */
+    if ( FAILED( hr ) && status == 401 && SUCCEEDED( RefreshUserToken( user ) ) )
+        hr = XboxLive::RequestXstsToken( user->userToken, user->proofKey, relyingParty.c_str(), out, &status,
+                                         user->deviceToken, user->titleToken );
+    if ( FAILED( hr ) )
+    {
+        WARN( "no XSTS token for relying party %s, hr %#lx.\n", relyingParty.c_str(), hr );
+        user->xstsRetryAfter[relyingParty] = now + minute;
+        return hr;
+    }
+    user->xstsRetryAfter.erase( relyingParty );
+    user->xsts[relyingParty] = *out;
+    return S_OK;
+}
+
+/* An HTTP request a token is asked for. */
+struct TokenRequest
+{
+    std::string method;
+    std::string url;
+    XboxLive::HttpHeaders headers;
+    std::vector<BYTE> body;
+};
+
+/* The token and, when the NSAL asks for one, the signature for a request.
+ * E_GAMEUSER_NO_TOKEN_REQUIRED when the NSAL gives the URL no relying party: tokens only go
+ * where it says. */
+static HRESULT GetTokenAndSignature( XUser *user, const XboxLive::NsalEndpoint *endpoint,
+                                     const XboxLive::SignaturePolicy *policy, const XboxLive::Url &url,
+                                     const TokenRequest &request, BOOL forceRefresh, std::string *token,
+                                     std::string *signature )
+{
+    XboxLive::XstsToken xsts;
+    HRESULT hr;
+
+    if ( !endpoint || endpoint->relyingParty.empty() )
+    {
+        TRACE( "%s://%s: no token.\n", url.scheme.c_str(), url.host.c_str() );
+        return E_GAMEUSER_NO_TOKEN_REQUIRED;
+    }
+    if ( endpoint->tokenType != "JWT" )
+    {
+        FIXME( "%s: token type %s not supported.\n", url.host.c_str(), endpoint->tokenType.c_str() );
+        return E_GAMEUSER_NO_TOKEN_REQUIRED;
+    }
+    if ( FAILED( hr = GetXsts( user, endpoint->relyingParty, forceRefresh, &xsts ) ) ) return hr;
+
+    *token = "XBL3.0 x=" + xsts.userHash + ";" + xsts.token;
+    signature->clear();
+    if ( policy )
+    {
+        hr = XboxLive::SignRequest( user->proofKey, *policy, request.method.c_str(), url.pathAndQuery, *token,
+                                    request.headers, request.body.data(), request.body.size(), signature );
+        if ( hr == E_NOTIMPL )
+            FIXME( "%s: signature policy version %u not supported, request not signed.\n", url.host.c_str(),
+                   policy->version );
+        else if ( FAILED( hr ) ) return hr;
+    }
+    TRACE( "%s: relying party %s, %s.\n", url.host.c_str(), endpoint->relyingParty.c_str(),
+           signature->empty() ? "not signed" : "signed" );
+    return S_OK;
+}
+
+/* The NSAL: the title's endpoints, then the default ones; shared by every user. The default
+ * list is public. The title's list takes a token from the default one. */
+static std::mutex nsalLock;
+static XboxLive::Nsal defaultNsal, nsal;
+static BOOL defaultNsalLoaded, titleNsalLoaded;
+static UINT64 defaultNsalRetryAfter, titleNsalRetryAfter;
+
+/* Called with nsalLock held; takes the user's tokensLock, never the other way round. */
+static HRESULT RequestTitleNsal( XUser *user, XboxLive::Nsal *title )
+{
+    UINT32 titleId = GetGameConfig().titleId;
+    std::string token, signature, path;
+    TokenRequest request;
+    XboxLive::Url url;
+    HRESULT hr;
+
+    if ( !titleId ) return E_GAMEUSER_NO_TITLE_ID;
+    /* Unlike the default list, the title's refuses "?type=1" (HTTP 414). */
+    path = "/titles/" + std::to_string( titleId ) + "/endpoints";
+    request.method = "GET";
+    request.url = "https://title.mgt.xboxlive.com" + path;
+    XboxLive::ParseUrl( request.url.c_str(), &url );
+
+    const XboxLive::NsalEndpoint *endpoint = defaultNsal.Find( url );
+    const XboxLive::SignaturePolicy *policy = endpoint && endpoint->signaturePolicy >= 0 ?
+                                              &defaultNsal.policies[endpoint->signaturePolicy] : nullptr;
+    if ( FAILED( hr = GetTokenAndSignature( user, endpoint, policy, url, request, FALSE, &token, &signature ) ) )
+        return hr;
+
+    std::wstring headers = L"Authorization: " + XboxLive::Widen( token ) + L"\r\n";
+    if ( !signature.empty() ) headers += L"Signature: " + XboxLive::Widen( signature ) + L"\r\n";
+    return XboxLive::RequestNsal( XboxLive::Widen( path ), headers, title );
+}
+
+/* Load what is missing of the NSAL, retrying a failed list after a minute. Only a missing
+ * default list is an error: without the title's, its own services get no tokens. */
+static HRESULT LoadNsal( XUser *user )
+{
+    const std::lock_guard<std::mutex> lock( nsalLock );
+    UINT64 now = XboxLive::Now();
+    XboxLive::Nsal title;
+    HRESULT hr;
+
+    if ( !defaultNsalLoaded )
+    {
+        if ( now < defaultNsalRetryAfter ) return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+        if ( FAILED( hr = XboxLive::RequestNsal( L"/titles/default/endpoints?type=1", std::wstring(), &defaultNsal ) ) )
+        {
+            WARN( "the default NSAL is unavailable, hr %#lx.\n", hr );
+            defaultNsal = XboxLive::Nsal();
+            defaultNsalRetryAfter = now + minute;
+            return hr;
+        }
+        defaultNsalLoaded = TRUE;
+        nsal = defaultNsal;
+    }
+    if ( !titleNsalLoaded && now >= titleNsalRetryAfter )
+    {
+        if ( FAILED( hr = RequestTitleNsal( user, &title ) ) )
+        {
+            WARN( "the title's NSAL is unavailable, hr %#lx.\n", hr );
+            titleNsalRetryAfter = now + minute;
+        }
+        else
+        {
+            TRACE( "NSAL: %zu endpoints of the title, %zu default ones.\n", title.endpoints.size(),
+                   defaultNsal.endpoints.size() );
+            titleNsalLoaded = TRUE;
+            nsal = std::move( title );
+            nsal.Append( defaultNsal );
+        }
+    }
+    return S_OK;
+}
+
+static const char tokenIdentity[] = "XUserGetTokenAndSignatureAsync";
+static const char tokenUtf16Identity[] = "XUserGetTokenAndSignatureUtf16Async";
+
+struct TokenContext
+{
+    XUser *user = nullptr;
+    BOOL forceRefresh = FALSE;
+    BOOL utf16 = FALSE;
+    TokenRequest request;
+    std::string token, signature;
+};
+
+static HRESULT ComputeTokenAndSignature( TokenContext *context )
+{
+    XboxLive::NsalEndpoint endpoint;
+    XboxLive::SignaturePolicy policy;
+    BOOL found = FALSE, signs = FALSE;
+    XboxLive::Url url;
+    HRESULT hr;
+
+    if ( !XboxLive::ParseUrl( context->request.url.c_str(), &url ) ) return E_INVALIDARG;
+    if ( FAILED( hr = LoadNsal( context->user ) ) ) return hr;
+    {
+        const std::lock_guard<std::mutex> lock( nsalLock );
+        if ( const XboxLive::NsalEndpoint *match = nsal.Find( url ) )
+        {
+            endpoint = *match;
+            found = TRUE;
+            if ( ( signs = match->signaturePolicy >= 0 ) ) policy = nsal.policies[match->signaturePolicy];
+        }
+    }
+    return GetTokenAndSignature( context->user, found ? &endpoint : nullptr, signs ? &policy : nullptr, url,
+                                 context->request, context->forceRefresh, &context->token, &context->signature );
+}
+
+/* The result: the structure, then the token and the signature, each with a terminating NUL that
+ * the sizes count (as Xal documents). A request that is not signed has a null signature. */
+static SIZE_T TokenResultSize( const TokenContext &context )
+{
+    SIZE_T characters = context.token.size() + 1 + ( context.signature.empty() ? 0 : context.signature.size() + 1 );
+    return context.utf16 ? sizeof(XUserGetTokenAndSignatureUtf16Data) + characters * sizeof(WCHAR)
+                         : sizeof(XUserGetTokenAndSignatureData) + characters;
+}
+
+template <typename Data, typename Char> static void WriteTokenResult( const TokenContext &context, void *buffer )
+{
+    auto *result = static_cast<Data *>(buffer);
+    Char *text = reinterpret_cast<Char *>(result + 1);
+
+    /* Tokens and signatures are ASCII. */
+    auto copy = [&text]( const std::string &value ) -> const Char *
+    {
+        const Char *start = text;
+        for ( char c : value ) *text++ = (Char)c;
+        *text++ = 0;
+        return start;
+    };
+    result->token = copy( context.token );
+    result->signature = context.signature.empty() ? nullptr : copy( context.signature );
+    if constexpr ( sizeof(Char) == sizeof(char) )
+    {
+        result->tokenSize = context.token.size() + 1;
+        result->signatureSize = context.signature.empty() ? 0 : context.signature.size() + 1;
+    }
+    else
+    {
+        result->tokenCount = context.token.size() + 1;
+        result->signatureCount = context.signature.empty() ? 0 : context.signature.size() + 1;
+    }
+}
+
+static HRESULT CALLBACK TokenProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    auto *context = static_cast<TokenContext *>(data->context);
+
+    switch ( op )
+    {
+        case XAsyncOp::Begin:
+            return XAsyncSchedule( data->async, 0 );
+
+        case XAsyncOp::DoWork:
+        {
+            HRESULT hr = ComputeTokenAndSignature( context );
+            XAsyncComplete( data->async, hr, SUCCEEDED( hr ) ? TokenResultSize( *context ) : 0 );
+            return S_OK;
+        }
+
+        case XAsyncOp::GetResult:
+            if ( context->utf16 ) WriteTokenResult<XUserGetTokenAndSignatureUtf16Data, WCHAR>( *context, data->buffer );
+            else WriteTokenResult<XUserGetTokenAndSignatureData, char>( *context, data->buffer );
+            return S_OK;
+
+        case XAsyncOp::Cleanup:
+            Release( context->user );
+            delete context;
+            return S_OK;
+
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT BeginTokenRequest( XUser *user, XUserGetTokenAndSignatureOptions options, TokenContext *context,
+                                  XAsyncBlock *async )
+{
+    const char *identity = context->utf16 ? tokenUtf16Identity : tokenIdentity;
+    HRESULT hr;
+
+    /* AllUsers asks for a token for every signed-in user: there is only one. */
+    context->forceRefresh = ( static_cast<UINT32>(options) &
+                              static_cast<UINT32>(XUserGetTokenAndSignatureOptions::ForceRefresh) ) != 0;
+    AddRef( user );
+    context->user = user;
+    if ( FAILED( hr = XAsyncBegin( async, context, identity, identity, TokenProvider ) ) )
+    {
+        Release( user );
+        delete context;
+    }
+    return hr;
+}
