+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __XGAMERUNTIME_XBOXLIVE_H__
+#define __XGAMERUNTIME_XBOXLIVE_H__
+
+#include "../private.h"
+#include "Nsal.h"
+
+#include <bcrypt.h>
+#include <winstring.h>
+#include <string>
+
+namespace XboxLive
+{
+
+/* An HTTPS request through WinHTTP; headers are "Name: value" lines separated by CRLF. */
+HRESULT HttpRequest( const wchar_t *method, const wchar_t *host, const wchar_t *path, const std::wstring &headers,
+                     const std::string &body, DWORD *status, std::string *response );
+
+/* UTF-8 to and from UTF-16; a length of -1 converts up to the NUL. */
+std::wstring Widen( const std::string &text );
+std::string Narrow( const wchar_t *text, int length = -1 );
+std::string Narrow( HSTRING text );
+
+/* The current time as a FILETIME, in 100 ns units. */
+UINT64 Now();
+
+/* The ECDSA P-256 key that proves possession of the XSTS tokens it was bound to. */
+class ProofKey
+{
+public:
+    ProofKey() = default;
+    ProofKey( const ProofKey & ) = delete;
+    ProofKey &operator=( const ProofKey & ) = delete;
+    ~ProofKey();
+
+    HRESULT Generate();
+    /* The public key as a JSON Web Key, as XSTS requests carry it. */
+    const std::string &Jwk() const { return jwk; }
+    /* ES256: ECDSA over the SHA-256 of data, r || s. */
+    HRESULT Sign( const BYTE *data, SIZE_T size, BYTE signature[64] ) const;
+
+private:
+    BCRYPT_ALG_HANDLE algorithm = nullptr;
+    BCRYPT_KEY_HANDLE key = nullptr;
+    std::string jwk;
+};
+
+/* What an XSTS token tells about the user (DisplayClaims.xui[0]). Optional claims are empty. */
+struct XstsToken
+{
+    std::string token;
+    std::string userHash;         /* uhs */
+    UINT64 xuid = 0;              /* xid */
+    std::string gamertag;         /* gtg */
+    std::string modernGamertag;   /* mgt */
+    std::string modernSuffix;     /* mgs */
+    std::string uniqueModern;     /* umg */
+    std::string ageGroup;         /* agg: Adult, Teen, Child */
+    std::string privileges;       /* prv: space-separated privilege numbers */
+    UINT64 notAfter = 0;          /* expiry as a FILETIME */
+};
+
+/* device.auth.xboxlive.com: a device token from the device's RPS ticket, bound to the proof key. */
+HRESULT RequestDeviceToken( const std::string &deviceTicket, const ProofKey &key, std::string *deviceToken,
+                            UINT64 *notAfter );
+
+/* What SISU authorization gives a title's MSA app on a device. */
+struct SisuTokens
+{
+    std::string userToken, titleToken;
+    UINT64 userNotAfter = 0, titleNotAfter = 0;
+    XstsToken xsts; /* for http://xboxlive.com */
+};
+
+/* sisu.xboxlive.com/authorize: user, title and XSTS tokens from the user's RPS ticket for the
+ * title's MSA app id and a device token, as Win32 titles sign in. */
+HRESULT SisuAuthorize( const std::string &rpsTicket, const char *appId, const std::string &deviceToken,
+                       const ProofKey &key, SisuTokens *tokens );
+
+/* xsts.auth.xboxlive.com: an XSTS token for a relying party, bound to the proof key, with the
+ * device and title tokens. On failure, httpStatus tells the HTTP status, if there was a response. */
+HRESULT RequestXstsToken( const std::string &userToken, const ProofKey &key, const char *relyingParty,
+                          XstsToken *xsts, DWORD *httpStatus = nullptr, const std::string &deviceToken = std::string(),
+                          const std::string &titleToken = std::string() );
+
+/* title.mgt.xboxlive.com: an NSAL, with the headers the request needs (none for the default one). */
+HRESULT RequestNsal( const std::wstring &path, const std::wstring &headers, Nsal *nsal );
+
+/* The Signature header for a request under a version 1 ES256 policy, signed now with the key;
+ * E_NOTIMPL for other policies. */
+HRESULT SignRequest( const ProofKey &key, const SignaturePolicy &policy, const char *method,
+                     const std::string &pathAndQuery, const std::string &authorization,
+                     const HttpHeaders &headers, const BYTE *body, SIZE_T bodySize, std::string *signature );
+
+}
+
+#endif
