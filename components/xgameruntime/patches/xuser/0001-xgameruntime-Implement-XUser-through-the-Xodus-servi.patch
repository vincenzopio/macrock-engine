+}
+
+class XUserLiveTests : public XGameRuntimeTests
+{
+protected:
+    void SetUp() override
+    {
+        const char *live = getenv("XGR_LIVE_XBOX");
+        if (!live || strcmp(live, "1")) GTEST_SKIP() << "set XGR_LIVE_XBOX=1 to sign in for real";
+    }
+
+    static XUserHandle Add()
+    {
+        XAsyncBlock block{};
+        XUserHandle user = nullptr;
+
+        EXPECT_HRESULT_SUCCEEDED(XUserAddAsync(XUserAddOptions::AddDefaultUserSilently, &block));
+        EXPECT_HRESULT_SUCCEEDED(XAsyncGetStatus(&block, TRUE));
+        EXPECT_HRESULT_SUCCEEDED(XUserAddResult(&block, &user));
+        return user;
+    }
+};
+
+TEST_F(XUserLiveTests, SignsInSilentlyThroughXodus)
+{
+    XUserHandle user = Add(), again, found = nullptr, duplicate = nullptr;
+    char gamertag[16], modern[97], unique[101];
+    XUserAgeGroup ageGroup = XUserAgeGroup::Unknown;
+    XUserPrivilegeDenyReason reason;
+    XUserLocalId localId{};
+    BOOLEAN multiplayer = FALSE, guest = TRUE;
+    XUserState state;
+    UINT64 xuid = 0;
+
+    ASSERT_NE(user, nullptr);
+    EXPECT_HRESULT_SUCCEEDED(XUserGetId(user, &xuid));
+    EXPECT_NE(xuid, 0u);
+    EXPECT_HRESULT_SUCCEEDED(XUserGetGamertag(user, XUserGamertagComponent::Classic, sizeof(gamertag), gamertag, nullptr));
+    EXPECT_GT(strlen(gamertag), 0u);
+    EXPECT_HRESULT_SUCCEEDED(XUserGetGamertag(user, XUserGamertagComponent::Modern, sizeof(modern), modern, nullptr));
+    EXPECT_HRESULT_SUCCEEDED(XUserGetGamertag(user, XUserGamertagComponent::UniqueModern, sizeof(unique), unique, nullptr));
+    EXPECT_HRESULT_SUCCEEDED(XUserGetAgeGroup(user, &ageGroup));
+    EXPECT_HRESULT_SUCCEEDED(XUserGetIsGuest(user, &guest));
+    EXPECT_FALSE(guest);
+    EXPECT_HRESULT_SUCCEEDED(XUserGetState(user, &state));
+    EXPECT_EQ(state, XUserState::SignedIn);
+    EXPECT_HRESULT_SUCCEEDED(XUserCheckPrivilege(user, XUserPrivilegeOptions::None, XUserPrivilege::Multiplayer, &multiplayer, &reason));
+    EXPECT_HRESULT_SUCCEEDED(XUserGetLocalId(user, &localId));
+    std::printf("[   LIVE   ] signed in: xuid set, gamertag %zu chars, unique modern gamertag %zu chars, age group %u, "
+                "multiplayer privilege %d\n", strlen(gamertag), strlen(unique), (unsigned)ageGroup, multiplayer);
+
+    // The same user is found again, by id and by local id, and added again.
+    EXPECT_HRESULT_SUCCEEDED(XUserFindUserById(xuid, &found));
+    EXPECT_EQ(XUserCompare(user, found), 0);
+    XUserCloseHandle(found);
+    EXPECT_HRESULT_SUCCEEDED(XUserFindUserByLocalId(localId, &found));
+    EXPECT_EQ(XUserCompare(user, found), 0);
+    XUserCloseHandle(found);
+    again = Add();
+    EXPECT_EQ(XUserCompare(user, again), 0);
+    XUserCloseHandle(again);
+    EXPECT_EQ(XUserFindUserById(xuid + 1, &found), E_GAMEUSER_USER_NOT_FOUND);
+
+    EXPECT_HRESULT_SUCCEEDED(XUserDuplicateHandle(user, &duplicate));
+    XUserCloseHandle(duplicate);
+    XUserCloseHandle(user);
+}
+
+/* A token request's outcome. Tests compare tokens, and print only their lengths. */
+struct TokenResult
+{
+    HRESULT hr = E_FAIL;
+    std::string token, signature;
+    bool signatureNull = true;
+    SIZE_T tokenSize = 0, signatureSize = 0;
+};
+
+static TokenResult GetToken( XUserHandle user, const char *method, const char *url,
+                             XUserGetTokenAndSignatureOptions options = XUserGetTokenAndSignatureOptions::None )
+{
+    XUserGetTokenAndSignatureData *data = nullptr;
+    XAsyncBlock block{};
+    TokenResult result;
+    SIZE_T size = 0;
+
+    if ( FAILED( result.hr = XUserGetTokenAndSignatureAsync( user, options, method, url, 0, nullptr, 0, nullptr, &block ) ) ||
+         FAILED( result.hr = XAsyncGetStatus( &block, TRUE ) ) ||
+         FAILED( result.hr = XUserGetTokenAndSignatureResultSize( &block, &size ) ) )
+        return result;
+    std::vector<char> buffer( size );
+    if ( FAILED( result.hr = XUserGetTokenAndSignatureResult( &block, size, buffer.data(), &data, nullptr ) ) ) return result;
+    result.token = data->token;
+    result.tokenSize = data->tokenSize;
+    result.signatureNull = !data->signature;
+    if ( data->signature ) result.signature = data->signature;
+    result.signatureSize = data->signatureSize;
+    return result;
+}
+
+static TokenResult GetTokenUtf16( XUserHandle user, const WCHAR *method, const WCHAR *url )
+{
+    XUserGetTokenAndSignatureUtf16Data *data = nullptr;
+    XAsyncBlock block{};
+    TokenResult result;
+    SIZE_T size = 0;
+
+    if ( FAILED( result.hr = XUserGetTokenAndSignatureUtf16Async( user, XUserGetTokenAndSignatureOptions::None, method, url,
+                                                                  0, nullptr, 0, nullptr, &block ) ) ||
+         FAILED( result.hr = XAsyncGetStatus( &block, TRUE ) ) ||
+         FAILED( result.hr = XUserGetTokenAndSignatureUtf16ResultSize( &block, &size ) ) )
+        return result;
+    std::vector<char> buffer( size );
+    if ( FAILED( result.hr = XUserGetTokenAndSignatureUtf16Result( &block, size, buffer.data(), &data, nullptr ) ) )
+        return result;
+    for ( const WCHAR *c = data->token; *c; ++c ) result.token += (char)*c;
+    result.tokenSize = data->tokenCount;
+    result.signatureNull = !data->signature;
+    for ( const WCHAR *c = data->signature; c && *c; ++c ) result.signature += (char)*c;
+    result.signatureSize = data->signatureCount;
+    return result;
+}
+
+/* An HTTPS GET made by the test itself; only the status comes back. */
+static DWORD HttpsGet( const wchar_t *host, const wchar_t *path, const std::string &headers )
+{
+    std::wstring wideHeaders( headers.begin(), headers.end() );
+    DWORD status = 0, size = sizeof(status);
+    HINTERNET session, connection = nullptr, request = nullptr;
+
+    if ( ( session = WinHttpOpen( L"xgameruntime-tests", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME,
+                                  WINHTTP_NO_PROXY_BYPASS, 0 ) ) &&
+         ( connection = WinHttpConnect( session, host, INTERNET_DEFAULT_HTTPS_PORT, 0 ) ) &&
+         ( request = WinHttpOpenRequest( connection, L"GET", path, nullptr, WINHTTP_NO_REFERER,
+                                         WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE ) ) &&
+         WinHttpSendRequest( request, wideHeaders.c_str(), (DWORD)-1L, WINHTTP_NO_REQUEST_DATA, 0, 0, 0 ) &&
+         WinHttpReceiveResponse( request, nullptr ) )
+        WinHttpQueryHeaders( request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX,
+                             &status, &size, WINHTTP_NO_HEADER_INDEX );
+    if ( request ) WinHttpCloseHandle( request );
+    if ( connection ) WinHttpCloseHandle( connection );
+    if ( session ) WinHttpCloseHandle( session );
+    return status;
+}
+
+TEST_F(XUserLiveTests, GivesSignedTokensForXboxLive)
+{
+    XUserHandle user = Add();
+    ASSERT_NE(user, nullptr);
+
+    TokenResult result = GetToken( user, "GET", "https://profile.xboxlive.com/users/me/profile/settings?settings=Gamertag" );
+    ASSERT_HRESULT_SUCCEEDED(result.hr);
+    EXPECT_EQ(result.token.compare( 0, 9, "XBL3.0 x=" ), 0);
+    EXPECT_EQ(result.tokenSize, result.token.size() + 1);
+    ASSERT_FALSE(result.signatureNull);
+    EXPECT_EQ(result.signature.size(), 104u);
+    EXPECT_EQ(result.signature.substr( 0, 6 ), "AAAAAQ"); // policy version 1
+    EXPECT_EQ(result.signatureSize, 105u);
+
+    DWORD status = HttpsGet( L"profile.xboxlive.com", L"/users/me/profile/settings?settings=Gamertag",
+                             "x-xbl-contract-version: 2\r\nAuthorization: " + result.token + "\r\nSignature: " +
+                             result.signature + "\r\n" );
+    std::printf("[   LIVE   ] profile.xboxlive.com: HTTP %lu; token %zu chars\n", status, result.token.size());
+    EXPECT_EQ(status, 200u);
+    XUserCloseHandle(user);
+}
+
+TEST_F(XUserLiveTests, GivesTokensOnlyWhereTheNsalSays)
+{
+    XUserHandle user = Add();
+    ASSERT_NE(user, nullptr);
+
+    // Hosts outside the NSAL, and plain HTTP, get no token at all.
+    EXPECT_EQ(GetToken( user, "GET", "https://example.com/" ).hr, E_GAMEUSER_NO_TOKEN_REQUIRED);
+    EXPECT_EQ(GetToken( user, "GET", "http://profile.xboxlive.com/users/me/profile/settings" ).hr,
+              E_GAMEUSER_NO_TOKEN_REQUIRED);
+
+    // Tokens come from a cache, per relying party; ForceRefresh asks for a new one.
+    TokenResult first = GetToken( user, "GET", "https://userpresence.xboxlive.com/users/me" );
+    TokenResult again = GetToken( user, "POST", "https://social.xboxlive.com/users/me/people" );
+    TokenResult forced = GetToken( user, "GET", "https://userpresence.xboxlive.com/users/me",
+                                   XUserGetTokenAndSignatureOptions::ForceRefresh );
+    ASSERT_HRESULT_SUCCEEDED(first.hr);
+    ASSERT_HRESULT_SUCCEEDED(again.hr);
+    ASSERT_HRESULT_SUCCEEDED(forced.hr);
+    EXPECT_EQ(first.token, again.token);
+
+    // PlayFab: another relying party, and requests that are not signed.
+    TokenResult playfab = GetToken( user, "POST", "https://playfabapi.com/" );
+    ASSERT_HRESULT_SUCCEEDED(playfab.hr);
+    EXPECT_NE(playfab.token, first.token);
+    EXPECT_TRUE(playfab.signatureNull);
+    EXPECT_EQ(playfab.signatureSize, 0u);
+    std::printf("[   LIVE   ] tokens: xboxlive.com %zu chars (forced refresh %s), playfab %zu chars, unsigned\n",
+                first.token.size(), forced.token == first.token ? "same token" : "new token", playfab.token.size());
+    XUserCloseHandle(user);
+}
+
+TEST_F(XUserLiveTests, Utf16ResultsMatch)
+{
+    XUserHandle user = Add();
+    ASSERT_NE(user, nullptr);
+
+    TokenResult narrow = GetToken( user, "GET", "https://userpresence.xboxlive.com/users/me" );
+    TokenResult wide = GetTokenUtf16( user, L"GET", L"https://userpresence.xboxlive.com/users/me" );
+    ASSERT_HRESULT_SUCCEEDED(narrow.hr);
+    ASSERT_HRESULT_SUCCEEDED(wide.hr);
+    EXPECT_EQ(wide.token, narrow.token);
+    EXPECT_EQ(wide.tokenSize, wide.token.size() + 1);
+    EXPECT_EQ(wide.signature.size(), 104u);
+    EXPECT_EQ(wide.signatureSize, 105u);
+    XUserCloseHandle(user);
+}
+
+/* The title's NSAL answers a token with title claims only, which come from SISU sign-in, whose
+ * device.auth.xboxlive.com step refuses a request whose signature is wrong (HTTP 403): a 200
+ * here means that sign-in and signatures work end to end. */
+TEST_F(XUserLiveTests, TitleNsalAnswersTheSignedInTitle)
+{
+    UINT32 titleId = 0;
+    XUserHandle user = Add();
+    ASSERT_NE(user, nullptr);
+    ASSERT_HRESULT_SUCCEEDED(XGameGetXboxTitleId( &titleId ));
+
+    std::string path = "/titles/" + std::to_string( titleId ) + "/endpoints";
+    std::wstring widePath( path.begin(), path.end() );
+    TokenResult result = GetToken( user, "GET", ( "https://title.mgt.xboxlive.com" + path ).c_str() );
+    ASSERT_HRESULT_SUCCEEDED(result.hr);
+    ASSERT_FALSE(result.signatureNull);
+
+    DWORD status = HttpsGet( L"title.mgt.xboxlive.com", widePath.c_str(), "x-xbl-contract-version: 1\r\nAuthorization: " +
+                             result.token + "\r\nSignature: " + result.signature + "\r\n" );
+    std::printf("[   LIVE   ] title.mgt.xboxlive.com: the title's NSAL, HTTP %lu\n", status);
+    EXPECT_EQ(status, 200u);
+    XUserCloseHandle(user);
+}
+
+/* Minecraft's own services are in its title's NSAL, each with its relying party. */
+TEST_F(XUserLiveTests, MinecraftServicesGetTheirOwnTokens)
+{
+    UINT32 titleId = 0;
+    ASSERT_HRESULT_SUCCEEDED(XGameGetXboxTitleId( &titleId ));
+    if ( titleId != 0x35760C07 ) GTEST_SKIP() << "not Minecraft's MicrosoftGame.config";
+    XUserHandle user = Add();
+    ASSERT_NE(user, nullptr);
+
+    TokenResult xboxLive = GetToken( user, "GET", "https://userpresence.xboxlive.com/users/me" );
+    TokenResult realms = GetToken( user, "GET", "https://pocket.realms.minecraft.net/worlds" );
+    TokenResult multiplayer = GetToken( user, "POST", "https://multiplayer.minecraft.net/authentication" );
+    ASSERT_HRESULT_SUCCEEDED(xboxLive.hr);
+    ASSERT_HRESULT_SUCCEEDED(realms.hr);
+    ASSERT_HRESULT_SUCCEEDED(multiplayer.hr);
+    EXPECT_NE(realms.token, xboxLive.token);
+    EXPECT_NE(multiplayer.token, xboxLive.token);
+    EXPECT_TRUE(realms.signatureNull);
+
+    // Realms accepts a token for its relying party only.
+    std::string headers = "Client-Version: 1.21.0\r\nUser-Agent: MCPE/UWP\r\nAuthorization: ";
+    DWORD realmsStatus = HttpsGet( L"pocket.realms.minecraft.net", L"/worlds", headers + realms.token + "\r\n" );
+    DWORD wrongStatus = HttpsGet( L"pocket.realms.minecraft.net", L"/worlds", headers + xboxLive.token + "\r\n" );
+    std::printf("[   LIVE   ] pocket.realms.minecraft.net/worlds: HTTP %lu with its token, %lu with an xboxlive.com one\n",
+                realmsStatus, wrongStatus);
+    EXPECT_EQ(realmsStatus, 200u);
+    EXPECT_EQ(wrongStatus, 401u);
+    XUserCloseHandle(user);
+}
