+class XUserNoAccountTests : public XGameRuntimeTests
+{
+protected:
+    void SetUp() override
+    {
+        const char *noAccount = getenv("XGR_XODUS_NO_ACCOUNT");
+        if (!noAccount || strcmp(noAccount, "1")) GTEST_SKIP() << "set XGR_XODUS_NO_ACCOUNT=1 with a service that has no account";
+    }
+};
+
+TEST_F(XUserNoAccountTests, NoDefaultUserWithoutAnAccount)
+{
+    XAsyncBlock block{};
+    XUserHandle user = nullptr;
+
+    // The service answers with an empty message: no ticket, so no user.
+    ASSERT_HRESULT_SUCCEEDED(XUserAddAsync(XUserAddOptions::AddDefaultUserSilently, &block));
+    EXPECT_EQ(XAsyncGetStatus(&block, TRUE), E_GAMEUSER_NO_DEFAULT_USER);
+    EXPECT_EQ(XUserAddResult(&block, &user), E_GAMEUSER_NO_DEFAULT_USER);
