new file mode 100644
index 0000000000000000000000000000000000000000..0ca5ee07e61368ce039816b444d761641e7faec4
--- /dev/null
+++ b/src/System/Nsal.cpp
@@ -0,0 +1,198 @@
+/*
+ * Xbox Game runtime Library
+ *  Network security authorization list (NSAL) and request signing
+ *
+ * Copyright 2026 vincenzopio (macrock)
+ *
