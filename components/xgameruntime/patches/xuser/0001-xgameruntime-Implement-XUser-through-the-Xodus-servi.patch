+/* Releases a COM pointer when it goes out of scope. */
+template <typename T> class Ref
+{
+public:
+    Ref() = default;
+    Ref( const Ref & ) = delete;
+    Ref &operator=( const Ref & ) = delete;
+    ~Ref() { if ( p ) p->Release(); }
+    T **operator&() { return &p; }
+    T *operator->() const { return p; }
+    T *get() const { return p; }
+    void reset() { if ( p ) p->Release(); p = nullptr; }
+
+private:
+    T *p = nullptr;
+};
+
+/* Closes a WinHTTP handle when it goes out of scope. */
+class Internet
+{
+public:
+    explicit Internet( HINTERNET handle = nullptr ) : h( handle ) {}
+    Internet( const Internet & ) = delete;
+    Internet &operator=( const Internet & ) = delete;
+    ~Internet() { if ( h ) WinHttpCloseHandle( h ); }
+    HINTERNET get() const { return h; }
+
+private:
+    HINTERNET h;
+};
+
+/* Deletes an HSTRING when it goes out of scope. */
+class String
+{
+public:
+    String() = default;
+    String( const String & ) = delete;
+    String &operator=( const String & ) = delete;
+    ~String() { WindowsDeleteString( s ); }
+    HSTRING *operator&() { return &s; }
+    HSTRING get() const { return s; }
+
+private:
+    HSTRING s = nullptr;
+};
+
+std::wstring Widen( const std::string &text )
+{
+    int length = MultiByteToWideChar( CP_UTF8, 0, text.data(), (int)text.size(), nullptr, 0 );
+    std::wstring wide( length, L'\0' );
+    MultiByteToWideChar( CP_UTF8, 0, text.data(), (int)text.size(), wide.data(), length );
+    return wide;
+}
+
+std::string Narrow( const wchar_t *text, int length )
+{
+    if ( length < 0 ) length = (int)wcslen( text );
+    int size = WideCharToMultiByte( CP_UTF8, 0, text, length, nullptr, 0, nullptr, nullptr );
+    std::string narrow( size, '\0' );
+    WideCharToMultiByte( CP_UTF8, 0, text, length, narrow.data(), size, nullptr, nullptr );
+    return narrow;
+}
+
+std::string Narrow( HSTRING text )
+{
+    UINT32 length;
+    const WCHAR *wide = WindowsGetStringRawBuffer( text, &length );
+    return Narrow( wide, (int)length );
+}
+
+static HRESULT MakeString( const wchar_t *text, HSTRING *out )
+{
+    return WindowsCreateString( text, (UINT32)wcslen( text ), out );
+}
+
+/* Escape text for a JSON string literal. */
+static std::string JsonEscape( const std::string &text )
+{
+    std::string escaped;
+    for ( unsigned char c : text )
+    {
+        if ( c == '"' || c == '\\' ) { escaped += '\\'; escaped += (char)c; }
+        else if ( c < 0x20 ) { char hex[8]; snprintf( hex, sizeof(hex), "\\u%04x", c ); escaped += hex; }
+        else escaped += (char)c;
+    }
+    return escaped;
+}
+
+/* One attempt; *error gets WinHTTP's error code on failure. */
+static HRESULT HttpAttempt( const wchar_t *method, const wchar_t *host, const wchar_t *path, const std::wstring &headers,
+                            const std::string &body, DWORD *status, std::string *response, DWORD *error )
+{
+    DWORD size = sizeof(*status), available;
+    auto fail = [error]() { *error = GetLastError(); return HRESULT_FROM_WIN32( *error ); };
+
+    Internet session( WinHttpOpen( L"xgameruntime", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME,
+                                   WINHTTP_NO_PROXY_BYPASS, 0 ) );
+    if ( !session.get() ) return fail();
+    WinHttpSetTimeouts( session.get(), 10000, 10000, 20000, 20000 );
+
+    Internet connection( WinHttpConnect( session.get(), host, INTERNET_DEFAULT_HTTPS_PORT, 0 ) );
+    if ( !connection.get() ) return fail();
+    Internet request( WinHttpOpenRequest( connection.get(), method, path, nullptr, WINHTTP_NO_REFERER,
+                                          WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE ) );
+    if ( !request.get() ) return fail();
+
+    if ( !WinHttpSendRequest( request.get(), headers.empty() ? WINHTTP_NO_ADDITIONAL_HEADERS : headers.c_str(),
+                              headers.empty() ? 0 : (DWORD)-1L, (void *)body.data(), (DWORD)body.size(),
+                              (DWORD)body.size(), 0 ) ||
+         !WinHttpReceiveResponse( request.get(), nullptr ) ||
+         !WinHttpQueryHeaders( request.get(), WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                               WINHTTP_HEADER_NAME_BY_INDEX, status, &size, WINHTTP_NO_HEADER_INDEX ) )
+        return fail();
+
+    response->clear();
+    for ( ;; )
+    {
+        if ( !WinHttpQueryDataAvailable( request.get(), &available ) ) return fail();
+        if ( !available ) break;
+        std::vector<char> chunk( available );
+        DWORD read = 0;
+        if ( !WinHttpReadData( request.get(), chunk.data(), available, &read ) ) return fail();
+        response->append( chunk.data(), read );
+    }
+    return S_OK;
+}
+
+HRESULT HttpRequest( const wchar_t *method, const wchar_t *host, const wchar_t *path, const std::wstring &headers,
+                     const std::string &body, DWORD *status, std::string *response )
+{
+    std::string name = Narrow( host );
+    DWORD error = 0;
+    HRESULT hr;
+
+    hr = HttpAttempt( method, host, path, headers, body, status, response, &error );
+    /* A connection the server closed while it was idle fails the next request on it: GETs, which
+     * change nothing, are tried once more. */
+    if ( FAILED( hr ) && !wcscmp( method, L"GET" ) )
+    {
+        WARN( "GET %s: WinHTTP error %lu, trying again.\n", name.c_str(), error );
+        hr = HttpAttempt( method, host, path, headers, body, status, response, &error );
+    }
+    if ( FAILED( hr ) ) WARN( "%s: WinHTTP error %lu.\n", name.c_str(), error );
+    return hr;
+}
+
+UINT64 Now()
+{
+    FILETIME now;
+
+    GetSystemTimeAsFileTime( &now );
+    return (UINT64)now.dwHighDateTime << 32 | now.dwLowDateTime;
+}
+
+/* An ISO 8601 UTC time ("2026-10-07T08:00:29.3191631Z") as a FILETIME, without the fraction of a
+ * second; 0 if it does not parse. */
+static UINT64 ParseTime( const std::string &text )
+{
+    unsigned year, month, day, hour, minute, second;
+    SYSTEMTIME time{};
+    FILETIME file;
+
+    if ( sscanf( text.c_str(), "%4u-%2u-%2uT%2u:%2u:%2u", &year, &month, &day, &hour, &minute, &second ) != 6 )
+        return 0;
+    time.wYear = (WORD)year; time.wMonth = (WORD)month; time.wDay = (WORD)day;
+    time.wHour = (WORD)hour; time.wMinute = (WORD)minute; time.wSecond = (WORD)second;
+    if ( !SystemTimeToFileTime( &time, &file ) ) return 0;
+    return (UINT64)file.dwHighDateTime << 32 | file.dwLowDateTime;
+}
+
+ProofKey::~ProofKey()
+{
+    if ( key ) BCryptDestroyKey( key );
+    if ( algorithm ) BCryptCloseAlgorithmProvider( algorithm, 0 );
+}
+
+HRESULT ProofKey::Generate()
+{
+    BYTE blob[sizeof(BCRYPT_ECCKEY_BLOB) + 64];
+    ULONG size = 0;
+    NTSTATUS status;
+
+    if ( !BCRYPT_SUCCESS( status = BCryptOpenAlgorithmProvider( &algorithm, BCRYPT_ECDSA_P256_ALGORITHM, nullptr, 0 ) ) ||
+         !BCRYPT_SUCCESS( status = BCryptGenerateKeyPair( algorithm, &key, 256, 0 ) ) ||
+         !BCRYPT_SUCCESS( status = BCryptFinalizeKeyPair( key, 0 ) ) ||
+         !BCRYPT_SUCCESS( status = BCryptExportKey( key, nullptr, BCRYPT_ECCPUBLIC_BLOB, blob, sizeof(blob), &size, 0 ) ) )
+        return HRESULT_FROM_NT( status );
+
+    const BYTE *x = blob + sizeof(BCRYPT_ECCKEY_BLOB), *y = x + 32;
+    jwk = "{\"crv\":\"P-256\",\"alg\":\"ES256\",\"use\":\"sig\",\"kty\":\"EC\",\"x\":\"" + Base64( x, 32, TRUE ) +
+          "\",\"y\":\"" + Base64( y, 32, TRUE ) + "\"}";
+    return S_OK;
+}
+
+HRESULT ProofKey::Sign( const BYTE *data, SIZE_T size, BYTE signature[64] ) const
+{
+    BYTE hash[32];
+    ULONG used = 0;
+    NTSTATUS status;
+
+    if ( !key ) return E_NOT_VALID_STATE;
+    if ( !BCRYPT_SUCCESS( status = BCryptHash( BCRYPT_SHA256_ALG_HANDLE, nullptr, 0, (PUCHAR)data, (ULONG)size,
+                                               hash, sizeof(hash) ) ) ||
+         !BCRYPT_SUCCESS( status = BCryptSignHash( key, nullptr, hash, sizeof(hash), signature, 64, &used, 0 ) ) )
+        return HRESULT_FROM_NT( status );
+    return used == 64 ? S_OK : E_UNEXPECTED;
+}
+
+/* Parse a JSON object from UTF-8 text with Windows.Data.Json. */
+static HRESULT ParseObject( const std::string &text, IJsonObject **object )
+{
+    Ref<IJsonValueStatics> statics;
+    Ref<IJsonValue> value;
+    String className, input;
+    std::wstring wide = Widen( text );
+    HRESULT hr;
+
+    if ( FAILED( hr = MakeString( RuntimeClass_Windows_Data_Json_JsonValue, &className ) ) ||
+         FAILED( hr = RoGetActivationFactory( className.get(), __uuidof( IJsonValueStatics ), (void **)&statics ) ) ||
+         FAILED( hr = WindowsCreateString( wide.c_str(), (UINT32)wide.size(), &input ) ) ||
+         FAILED( hr = statics->Parse( input.get(), &value ) ) )
+        return hr;
+    return value->GetObject( object );
+}
+
+static HRESULT GetString( IJsonObject *object, const wchar_t *name, std::string *out )
+{
+    String key, value;
+    HRESULT hr;
+
+    if ( FAILED( hr = MakeString( name, &key ) ) || FAILED( hr = object->GetNamedString( key.get(), &value ) ) ) return hr;
+    *out = Narrow( value.get() );
+    return S_OK;
+}
+
+static HRESULT GetNumber( IJsonObject *object, const wchar_t *name, DOUBLE *out )
+{
+    String key;
+    HRESULT hr;
+
+    if ( FAILED( hr = MakeString( name, &key ) ) ) return hr;
+    return object->GetNamedNumber( key.get(), out );
+}
+
+static HRESULT GetArray( IJsonObject *object, const wchar_t *name, IJsonArray **out )
+{
+    String key;
+    HRESULT hr;
+
+    if ( FAILED( hr = MakeString( name, &key ) ) ) return hr;
+    return object->GetNamedArray( key.get(), out );
+}
+
+/* The strings of an array, which may be absent. Wine's JsonArray has no size: read up to E_BOUNDS. */
+static std::vector<std::string> GetStrings( IJsonObject *object, const wchar_t *name )
+{
+    std::vector<std::string> strings;
+    Ref<IJsonArray> array;
+
+    if ( FAILED( GetArray( object, name, &array ) ) ) return strings;
+    for ( UINT32 i = 0;; ++i )
+    {
+        String value;
+        if ( FAILED( array->GetStringAt( i, &value ) ) ) break;
+        strings.push_back( Narrow( value.get() ) );
+    }
+    return strings;
+}
+
+/* Log an Xbox Live failure without anything secret: the HTTP status and the XErr code. */
+static HRESULT Failure( const char *what, DWORD status, const std::string &response )
+{
+    const char *xerr = strstr( response.c_str(), "\"XErr\":" );
+    WARN( "%s failed: HTTP %lu, XErr %s.\n", what, status,
+          xerr ? std::string( xerr + 7, strcspn( xerr + 7, ",}" ) ).c_str() : "none" );
+    return E_GAMEUSER_FAILED_TO_GET_TOKEN;
+}
+
+static const wchar_t jsonHeaders[] = L"Content-Type: application/json\r\nAccept: application/json\r\n"
+                                     L"x-xbl-contract-version: 1\r\n";
+
+/* POST to an Xbox Live authentication service, signed with the proof key under the policy of
+ * *.xboxlive.com in the default NSAL: version 1, ES256, 8 KiB of body. */
+static HRESULT PostSigned( const ProofKey &key, const wchar_t *host, const wchar_t *path, const std::wstring &headers,
+                           const std::string &body, DWORD *status, std::string *response )
+{
+    std::string signature, narrowPath;
+    SignaturePolicy policy;
+    HRESULT hr;
+
+    for ( const wchar_t *c = path; *c; ++c ) narrowPath += (char)*c;
+    policy.version = 1;
+    policy.maxBodyBytes = 8192;
+    policy.es256 = TRUE;
+    if ( FAILED( hr = SignRequest( key, policy, "POST", narrowPath, std::string(), HttpHeaders(),
+                                   reinterpret_cast<const BYTE *>(body.data()), body.size(), &signature ) ) )
+        return hr;
+    return HttpRequest( L"POST", host, path, headers + L"Signature: " + Widen( signature ) + L"\r\n", body, status,
+                        response );
+}
+
+/* A token and its expiry ("Token" and "NotAfter"; 0 without one) from an object of a response. */
+static HRESULT ReadToken( IJsonObject *object, std::string *token, UINT64 *notAfter )
+{
+    std::string expiry;
+    HRESULT hr;
+
+    if ( FAILED( hr = GetString( object, L"Token", token ) ) ) return hr;
+    *notAfter = SUCCEEDED( GetString( object, L"NotAfter", &expiry ) ) ? ParseTime( expiry ) : 0;
+    return S_OK;
+}
+
+/* The token, expiry (an hour when the response has none) and user claims of an XSTS response. */
+static HRESULT ParseXsts( IJsonObject *object, XstsToken *xsts )
+{
+    Ref<IJsonObject> claims, user;
+    Ref<IJsonArray> users;
+    String claimsName;
+    std::string xid;
+    HRESULT hr;
+
+    if ( FAILED( hr = ReadToken( object, &xsts->token, &xsts->notAfter ) ) ||
+         FAILED( hr = MakeString( L"DisplayClaims", &claimsName ) ) ||
+         FAILED( hr = object->GetNamedObject( claimsName.get(), &claims ) ) ||
+         FAILED( hr = GetArray( claims.get(), L"xui", &users ) ) ||
+         FAILED( hr = users->GetObjectAt( 0, &user ) ) ||
+         FAILED( hr = GetString( user.get(), L"uhs", &xsts->userHash ) ) )
+        return hr;
+    if ( !xsts->notAfter ) xsts->notAfter = Now() + 3600ull * 10000000;
+
+    /* Not every relying party carries every claim. */
+    if ( SUCCEEDED( GetString( user.get(), L"xid", &xid ) ) ) xsts->xuid = strtoull( xid.c_str(), nullptr, 10 );
+    GetString( user.get(), L"gtg", &xsts->gamertag );
+    GetString( user.get(), L"mgt", &xsts->modernGamertag );
+    GetString( user.get(), L"mgs", &xsts->modernSuffix );
+    GetString( user.get(), L"umg", &xsts->uniqueModern );
+    GetString( user.get(), L"agg", &xsts->ageGroup );
+    GetString( user.get(), L"prv", &xsts->privileges );
+    return S_OK;
+}
+
+/* A token and its expiry from a member of a response ("TitleToken": {"Token": ..., "NotAfter": ...}). */
+static HRESULT GetToken( IJsonObject *object, const wchar_t *name, std::string *token, UINT64 *notAfter )
+{
+    Ref<IJsonObject> member;
+    String key;
+    HRESULT hr;
+
+    if ( FAILED( hr = MakeString( name, &key ) ) || FAILED( hr = object->GetNamedObject( key.get(), &member ) ) )
+        return hr;
+    return ReadToken( member.get(), token, notAfter );
+}
+
+HRESULT RequestDeviceToken( const std::string &deviceTicket, const ProofKey &key, std::string *deviceToken,
+                            UINT64 *notAfter )
+{
+    std::string body = "{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{"
+                       "\"AuthMethod\":\"RPS\",\"RpsTicket\":\"" + JsonEscape( deviceTicket ) + "\","
+                       "\"SiteName\":\"user.auth.xboxlive.com\",\"Version\":\"10.0.22621\",\"ProofKey\":" +
+                       key.Jwk() + "}}";
+    Ref<IJsonObject> object;
+    std::string response;
+    DWORD status = 0;
+    HRESULT hr;
+
+    if ( FAILED( hr = PostSigned( key, L"device.auth.xboxlive.com", L"/device/authenticate", jsonHeaders, body,
+                                  &status, &response ) ) )
+        return hr;
+    if ( status != 200 ) return Failure( "device token", status, response );
+    if ( FAILED( hr = ParseObject( response, &object ) ) ) return hr;
+    return ReadToken( object.get(), deviceToken, notAfter );
+}
+
+HRESULT SisuAuthorize( const std::string &rpsTicket, const char *appId, const std::string &deviceToken,
+                       const ProofKey &key, SisuTokens *tokens )
+{
+    static const wchar_t sisuHeaders[] = L"Content-Type: application/json\r\nAccept: application/json\r\n";
+    std::string body = "{\"AccessToken\":\"" + JsonEscape( rpsTicket ) + "\",\"AppId\":\"" + JsonEscape( appId ) +
+                       "\",\"DeviceToken\":\"" + JsonEscape( deviceToken ) + "\",\"Sandbox\":\"RETAIL\","
+                       "\"SiteName\":\"user.auth.xboxlive.com\",\"ProofKey\":" + key.Jwk() + "}";
+    Ref<IJsonObject> object, authorization;
+    std::string response;
+    String authorizationName;
+    DWORD status = 0;
+    HRESULT hr;
+
+    if ( FAILED( hr = PostSigned( key, L"sisu.xboxlive.com", L"/authorize", sisuHeaders, body, &status, &response ) ) )
+        return hr;
+    if ( status != 200 ) return Failure( "SISU authorization", status, response );
+    if ( FAILED( hr = ParseObject( response, &object ) ) ||
+         FAILED( hr = GetToken( object.get(), L"TitleToken", &tokens->titleToken, &tokens->titleNotAfter ) ) ||
+         FAILED( hr = GetToken( object.get(), L"UserToken", &tokens->userToken, &tokens->userNotAfter ) ) ||
+         FAILED( hr = MakeString( L"AuthorizationToken", &authorizationName ) ) ||
+         FAILED( hr = object->GetNamedObject( authorizationName.get(), &authorization ) ) )
+        return hr;
+    return ParseXsts( authorization.get(), &tokens->xsts );
+}
+
+HRESULT RequestXstsToken( const std::string &userToken, const ProofKey &key, const char *relyingParty,
+                          XstsToken *xsts, DWORD *httpStatus, const std::string &deviceToken,
+                          const std::string &titleToken )
+{
+    std::string body = "{\"RelyingParty\":\"" + JsonEscape( relyingParty ) + "\",\"TokenType\":\"JWT\",\"Properties\":{"
+                       "\"SandboxId\":\"RETAIL\",";
+    std::string response;
+    Ref<IJsonObject> object;
+    DWORD status = 0;
+    HRESULT hr;
+
+    if ( !deviceToken.empty() ) body += "\"DeviceToken\":\"" + JsonEscape( deviceToken ) + "\",";
+    if ( !titleToken.empty() ) body += "\"TitleToken\":\"" + JsonEscape( titleToken ) + "\",";
+    body += "\"ProofKey\":" + key.Jwk() + ",\"UserTokens\":[\"" + JsonEscape( userToken ) + "\"]}}";
+
+    hr = PostSigned( key, L"xsts.auth.xboxlive.com", L"/xsts/authorize", jsonHeaders, body, &status, &response );
+    if ( httpStatus ) *httpStatus = status;
+    if ( FAILED( hr ) ) return hr;
+    if ( status != 200 ) return Failure( "XSTS token", status, response );
+    if ( FAILED( hr = ParseObject( response, &object ) ) ) return hr;
+    return ParseXsts( object.get(), xsts );
+}
+
+static HRESULT ParseNsal( const std::string &text, Nsal *nsal )
+{
+    Ref<IJsonObject> object;
+    Ref<IJsonArray> policies, endpoints;
+    HRESULT hr;
+
+    if ( FAILED( hr = ParseObject( text, &object ) ) || FAILED( hr = GetArray( object.get(), L"EndPoints", &endpoints ) ) )
+        return hr;
+
+    /* A title's list has no policies of its own: its requests are not signed. */
+    if ( FAILED( GetArray( object.get(), L"SignaturePolicies", &policies ) ) ) policies.reset();
+    for ( UINT32 i = 0; policies.get(); ++i )
+    {
+        Ref<IJsonObject> entry;
+        SignaturePolicy policy;
+        DOUBLE version = 0, maxBodyBytes = 0;
+
+        if ( ( hr = policies->GetObjectAt( i, &entry ) ) == E_BOUNDS ) break;
+        if ( FAILED( hr ) ) return hr;
+        GetNumber( entry.get(), L"Version", &version );
+        GetNumber( entry.get(), L"MaxBodyBytes", &maxBodyBytes );
+        policy.version = (UINT32)version;
+        policy.maxBodyBytes = (UINT64)maxBodyBytes;
+        for ( const std::string &algorithm : GetStrings( entry.get(), L"SupportedAlgorithms" ) )
+            if ( algorithm == "ES256" ) policy.es256 = TRUE;
+        policy.extraHeaders = GetStrings( entry.get(), L"ExtraHeaders" );
+        nsal->policies.push_back( policy );
+    }
+
+    for ( UINT32 i = 0;; ++i )
+    {
+        Ref<IJsonObject> entry;
+        NsalEndpoint endpoint;
+        std::string hostType;
+        DOUBLE index;
+
+        if ( ( hr = endpoints->GetObjectAt( i, &entry ) ) == E_BOUNDS ) break;
+        if ( FAILED( hr ) ) return hr;
+        if ( FAILED( GetString( entry.get(), L"Protocol", &endpoint.protocol ) ) ||
+             FAILED( GetString( entry.get(), L"Host", &endpoint.host ) ) ||
+             FAILED( GetString( entry.get(), L"HostType", &hostType ) ) )
+            continue;
+        endpoint.protocol = Lower( endpoint.protocol );
+        endpoint.host = Lower( endpoint.host );
+        /* "*.example.com" matches below example.com, "*" any host. */
+        if ( hostType == "wildcard" && ( endpoint.host == "*" || endpoint.host.compare( 0, 2, "*." ) == 0 ) )
+        {
+            endpoint.wildcard = TRUE;
+            endpoint.host.erase( 0, 1 );
+        }
+        else if ( hostType != "fqdn" )
+        {
+            FIXME( "NSAL host type %s not supported.\n", hostType.c_str() );
+            continue;
+        }
+        GetString( entry.get(), L"Path", &endpoint.path );
+        GetString( entry.get(), L"RelyingParty", &endpoint.relyingParty );
+        GetString( entry.get(), L"TokenType", &endpoint.tokenType );
+        if ( SUCCEEDED( GetNumber( entry.get(), L"SignaturePolicyIndex", &index ) ) && index >= 0 &&
+             index < (DOUBLE)nsal->policies.size() )
+            endpoint.signaturePolicy = (INT32)index;
+        nsal->endpoints.push_back( std::move( endpoint ) );
+    }
+    return S_OK;
+}
+
+HRESULT RequestNsal( const std::wstring &path, const std::wstring &headers, Nsal *nsal )
+{
+    std::wstring allHeaders = L"Accept: application/json\r\nx-xbl-contract-version: 1\r\n" + headers;
+    std::string response;
+    DWORD status = 0;
+    HRESULT hr;
+
+    if ( FAILED( hr = HttpRequest( L"GET", L"title.mgt.xboxlive.com", path.c_str(), allHeaders, std::string(),
+                                   &status, &response ) ) )
+        return hr;
+    if ( status != 200 ) return Failure( "NSAL", status, response );
+    return ParseNsal( response, nsal );
+}
+
+HRESULT SignRequest( const ProofKey &key, const SignaturePolicy &policy, const char *method,
+                     const std::string &pathAndQuery, const std::string &authorization,
+                     const HttpHeaders &headers, const BYTE *body, SIZE_T bodySize, std::string *signature )
+{
+    UINT64 timestamp = Now();
+    BYTE raw[64];
+    HRESULT hr;
+
+    if ( policy.version != 1 || !policy.es256 ) return E_NOTIMPL;
+    std::string payload = SigningPayload( policy, timestamp, method, pathAndQuery, authorization, headers, body, bodySize );
+    if ( FAILED( hr = key.Sign( reinterpret_cast<const BYTE *>(payload.data()), payload.size(), raw ) ) ) return hr;
+    *signature = SignatureHeader( policy.version, timestamp, raw );
+    return S_OK;
+}
+
+}
