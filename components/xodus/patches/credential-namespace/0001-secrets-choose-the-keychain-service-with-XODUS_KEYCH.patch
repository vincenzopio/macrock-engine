From: vincenzopio <43883474+vincenzopio@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:08:01 +0200
Subject: [PATCH] secrets: choose the keychain service with
 XODUS_KEYCHAIN_SERVICE.

XODUS_KEYCHAIN_SERVICE selects the keychain service the credentials are stored under, so that
each account keeps its own; without it they stay under "Xodus Service".

Original work for macrock (GPL-3.0-only, as Xodus).

Topic: credential-namespace
---
 crates/xodus/src/secrets.rs | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/crates/xodus/src/secrets.rs b/crates/xodus/src/secrets.rs
index dba6b2f24d29607825b41adf54719284d8f58d73..ef013b9a10f698dc0838dacfb44b7caff7ebdc36 100644
--- a/crates/xodus/src/secrets.rs
+++ b/crates/xodus/src/secrets.rs
@@ -35,8 +35,16 @@ pub fn init_secrets() -> Result<(), keyring_core::Error> {
     Ok(())
 }
 
+/// XODUS_KEYCHAIN_SERVICE when set (one keychain service per account), otherwise SERVICE_NAME.
+pub fn service_name() -> String {
+    std::env::var("XODUS_KEYCHAIN_SERVICE")
+        .ok()
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| SERVICE_NAME.to_string())
+}
+
 pub fn get_entry(user: &str) -> Result<keyring_core::Entry, keyring_core::Error> {
-    keyring_core::Entry::new(SERVICE_NAME, user)
+    keyring_core::Entry::new(&service_name(), user)
 }
 
 pub fn destroy_secrets() {
