diff --git a/crates/xodus/src/licensing/game.rs b/crates/xodus/src/licensing/game.rs
new file mode 100644
index 0000000000000000000000000000000000000000..aec01623b54650e2dd0f6b26e32cf03112e620b3
--- /dev/null
+++ b/crates/xodus/src/licensing/game.rs
@@ -0,0 +1,138 @@
+//! The game license of the signed-in account, as Gaming Services gets it for a title's
+//! XStoreQueryGameLicense: the title's package from the display catalog, then a license for its
+//! content from the licensing service, with the device's and the user's MSA tokens. A license
+//! the service cannot satisfy means that the account does not own the title.
+
+use crate::api::displaycatalog::find_products_by_id;
+use crate::api::live::{exchange_device_token, exchange_user_token};
+use crate::licensing::content::{LicenseContentError, get_license_content};
+use crate::models::live::ExchangeUserTokenOutcome;
+use crate::models::secrets::Token;
+use crate::models::soap;
+use crate::tokens::TokenManager;
+
+const LICENSING_APP_ID: &str = "{d6d5a677-0872-4ab0-9442-bb792fce85c5}";
+
+/// What a game license query found out.
+#[derive(Debug, Default)]
+pub struct GameLicense {
+    pub is_active: bool,
+    pub is_trial: bool,
+    pub sku_store_id: String,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum GameLicenseError {
+    #[error("catalog: {0}")]
+    Catalog(String),
+    #[error("tokens: {0}")]
+    Tokens(String),
+    #[error("request error: {0}")]
+    Request(#[from] reqwest::Error),
+}
+
+pub async fn query_game_license(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    store_id: &str,
+    market: &str,
+) -> Result<GameLicense, GameLicenseError> {
+    let neutral = vec!["neutral".to_owned()];
+    let catalog = find_products_by_id(client, store_id.to_owned(), market.to_owned(), neutral).await?;
+    let mut content_id = None;
+    // A license does not name the SKU it satisfies: take the first the Store licenses.
+    let (mut full_sku, mut trial_sku) = (None, None);
+    for availability in &catalog.product.display_sku_availabilities {
+        let sku = &availability.sku;
+        let licensable = availability
+            .availabilities
+            .iter()
+            .any(|a| a.actions.iter().any(|action| action == "License"));
+        let slot = if sku.properties.is_trial { &mut trial_sku } else { &mut full_sku };
+        if licensable && slot.is_none() {
+            *slot = Some(format!("{store_id}/{}", sku.sku_id));
+        }
+        if content_id.is_none() {
+            content_id = sku
+                .properties
+                .packages
+                .iter()
+                .find(|package| {
+                    package.platform_dependencies.iter().any(|dep| dep.platform_name == "Windows.Desktop")
+                })
+                .and_then(|package| package.content_id.clone());
+        }
+    }
+    let content_id = content_id.ok_or_else(|| {
+        GameLicenseError::Catalog(format!("no Windows.Desktop package for {store_id}"))
+    })?;
+
+    let (device_token, user_token, puid) = licensing_tokens(client, tokens).await?;
+    match get_license_content(client, device_token, user_token, puid, content_id, market.to_owned()).await {
+        Ok((_content, license)) => {
+            let is_trial = license.license_info.license_category.as_deref() == Some("Trial");
+            let sku_store_id = if is_trial { trial_sku } else { full_sku }.unwrap_or_default();
+            Ok(GameLicense { is_active: true, is_trial, sku_store_id })
+        }
+        Err(LicenseContentError::NotEntitled { description }) => {
+            tracing::info!("No license for {store_id}: {description}");
+            Ok(GameLicense::default())
+        }
+        Err(LicenseContentError::Request(error)) => Err(error.into()),
+    }
+}
+
+/// The device's and the user's MSA tokens for the licensing service, and the user's PUID.
+async fn licensing_tokens(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+) -> Result<(String, String, String), GameLicenseError> {
+    let failed = |what: &str| GameLicenseError::Tokens(what.to_owned());
+    let Ok(Token::Legacy(device_sts)) = tokens.get_device_sts_token() else {
+        return Err(failed("no device STS token"));
+    };
+    let user = tokens.get_user().map_err(|_| failed("no signed-in user"))?;
+    let Ok(Token::Legacy(user_sts)) = tokens.get_user_sts_token() else {
+        return Err(failed("no user STS token"));
+    };
+    let policy = || Some(soap::PolicyReference::mbi_ssl());
+
+    let device_token = exchange_device_token(
+        client,
+        device_sts.clone(),
+        LICENSING_APP_ID.to_owned(),
+        "www.microsoft.com".to_owned(),
+        policy(),
+    )
+    .await
+    .map_err(|_| failed("device token exchange"))?;
+    let Token::Compact(device_token) = Token::from(device_token) else {
+        return Err(failed("unexpected device token"));
+    };
+
+    let outcome = exchange_user_token(
+        client,
+        user_sts,
+        user.username,
+        device_sts,
+        None,
+        Some("Silent".to_owned()),
+        LICENSING_APP_ID.to_owned(),
+        &[("www.microsoft.com".to_owned(), policy())],
+    )
+    .await
+    .map_err(|_| failed("user token exchange"))?;
+    let user_token: Token = match outcome {
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponseCollection(mut collection))
+            if !collection.security_tokens.is_empty() =>
+        {
+            collection.security_tokens.remove(0).into()
+        }
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(token)) => (*token).into(),
+        _ => return Err(failed("user token exchange refused")),
+    };
+    let Token::Compact(user_token) = user_token else {
+        return Err(failed("unexpected user token"));
+    };
+    Ok((device_token, user_token, user.puid))
+}
