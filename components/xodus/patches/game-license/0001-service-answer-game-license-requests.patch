diff --git a/crates/xodus-service/src/connection/xml.rs b/crates/xodus-service/src/connection/xml.rs
index 8ce765b05e5899a7e1b8f4ea19213cfc408ebcc0..ee112d5274939f991cc432f8bd180923801c0a7e 100644
--- a/crates/xodus-service/src/connection/xml.rs
+++ b/crates/xodus-service/src/connection/xml.rs
@@ -2,6 +2,7 @@ use tokio::io::{AsyncReadExt, AsyncWriteExt};
 use xodus::models::live::ExchangeUserTokenOutcome;
 use xodus::models::secrets::Token;
 use xodus::models::soap;
+use xodus::models::xgameruntime::xstore::{GameLicenseRequest, GameLicenseResponse};
 use xodus::models::xgameruntime::xuser::{MSATokenRequest, MSATokenResponse};
 use xodus::proto::xodus::XodusMessageType;
 
@@ -127,6 +128,36 @@ pub async fn parse_message(
                 _ => todo!("Error handling sill sucks"),
             }
         }
+        XodusMessageType::GameLicenseRequest => {
+            let req = quick_xml::de::from_str::<GameLicenseRequest>(std::str::from_utf8(&buffer)?)?;
+            let market = req.market.unwrap_or_else(|| "US".to_owned());
+            let payload = match xodus::licensing::game::query_game_license(
+                &context.client,
+                context.tokens(),
+                &req.store_id,
+                &market,
+            )
+            .await
+            {
+                Ok(license) => {
+                    tracing::info!(
+                        "Game license for {}: active {}, trial {}",
+                        req.store_id, license.is_active, license.is_trial
+                    );
+                    GameLicenseResponse {
+                        is_active: license.is_active,
+                        is_trial: license.is_trial,
+                        sku_store_id: license.sku_store_id,
+                        ..Default::default()
+                    }
+                }
+                Err(err) => {
+                    tracing::warn!("Game license for {} unknown: {err}", req.store_id);
+                    GameLicenseResponse { result: 0x80004005, ..Default::default() } // E_FAIL
+                }
+            };
+            Ok(quick_xml::se::to_string(&payload)?.into_bytes())
+        }
         _ => Err("Unimplemented".into()),
     }
 }
