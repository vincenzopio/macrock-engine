@@ -0,0 +1,24 @@
+use serde::{Deserialize, Serialize};
+
+/// A title asking whether the signed-in account may play it (XStoreQueryGameLicense).
+#[derive(Deserialize, Debug)]
+#[serde(rename_all = "PascalCase")]
+pub struct GameLicenseRequest {
+    /// The title's Store product id (StoreId in its MicrosoftGame.config).
+    pub store_id: String,
+    /// The Store market, e.g. "US".
+    #[serde(default)]
+    pub market: Option<String>,
+}
+
+#[derive(Serialize, Debug, Default)]
+#[serde(rename_all = "PascalCase")]
+pub struct GameLicenseResponse {
+    /// 0, or the HRESULT of a failure to find out; an account without a license gets 0 and
+    /// IsActive false.
+    pub result: u32,
+    pub is_active: bool,
+    pub is_trial: bool,
+    /// "<product id>/<sku id>" when known.
+    pub sku_store_id: String,
+}
