From: vincenzopio <43883474+vincenzopio@users.noreply.github.com>
Date: Wed, 4 Nov 2026 14:42:53 +0100
Subject: [PATCH] licensing: tell the HTTP status of an answer that is not a
 license.

A content license request read the answer as a license or a refusal whatever its status, so an
error answer, such as a 401 with an empty body, failed as "error decoding response body", and the
status was lost. Such an answer now fails with its status. A refusal is still read as one,
whatever the status.

Original work for macrock (GPL-3.0-only, as Xodus).

Topic: game-license
---
 crates/xodus/src/licensing/content.rs | 47 ++++++++++++++++++++++++++-
 1 file changed, 46 insertions(+), 1 deletion(-)

diff --git a/crates/xodus/src/licensing/content.rs b/crates/xodus/src/licensing/content.rs
index 6ad979711aa9fc0bf77f3cca86d72b83a78fc152..900543d7bffeb11a177d960fea568428e6a583b9 100644
--- a/crates/xodus/src/licensing/content.rs
+++ b/crates/xodus/src/licensing/content.rs
@@ -73,7 +73,7 @@ pub async fn get_license_content(
         .send()
         .await?;
 
-    let content_res = response.json::<LicenseContentResponse>().await?;
+    let content_res = read_answer(response).await?;
     let content = match content_res {
         LicenseContentResponse::Success { license } => license,
         LicenseContentResponse::SatisfactionFailure {
@@ -88,6 +88,13 @@ pub async fn get_license_content(
     Ok((content, license))
 }
 
+/// The licensing service's answer: a license or a refusal. Any other answer fails with its HTTP
+/// status when that is an error, which says why, rather than with the body's decoding error.
+async fn read_answer(response: reqwest::Response) -> reqwest::Result<LicenseContentResponse> {
+    let status = response.error_for_status_ref().err();
+    response.json().await.map_err(|err| status.unwrap_or(err))
+}
+
 pub async fn get_license_token(
     client: &reqwest::Client,
     device_ms_token: String,
@@ -126,8 +133,46 @@ pub async fn get_license_token(
 
 #[cfg(test)]
 mod tests {
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+    use tokio::net::TcpListener;
+
     use super::*;
 
+    /// The answer of a local server that gives `answer`, raw HTTP, to one request.
+    async fn answer(answer: &'static str) -> reqwest::Response {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/", listener.local_addr().unwrap());
+        tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let (reader, mut writer) = socket.split();
+            let mut lines = BufReader::new(reader).lines();
+            while lines.next_line().await.unwrap().is_some_and(|line| !line.is_empty()) {}
+            writer.write_all(answer.as_bytes()).await.unwrap();
+        });
+        reqwest::get(url).await.unwrap()
+    }
+
+    #[tokio::test]
+    async fn an_answer_that_is_not_a_license_fails_with_its_http_status() {
+        let response = answer("HTTP/1.1 401 Unauthorized\r\nConnection: close\r\n\r\n").await;
+        let err = read_answer(response).await.unwrap_err();
+        assert_eq!(err.status(), Some(reqwest::StatusCode::UNAUTHORIZED));
+    }
+
+    #[tokio::test]
+    async fn a_refusal_is_read_whatever_the_http_status() {
+        let response = answer(concat!(
+            "HTTP/1.1 400 Bad Request\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n",
+            r#"{"satisfactionFailure":{"code":501,"description":"Full"}}"#,
+        ))
+        .await;
+        let read = read_answer(response).await.unwrap();
+        assert!(matches!(
+            read,
+            LicenseContentResponse::SatisfactionFailure { satisfaction_failure } if satisfaction_failure.code == 501
+        ));
+    }
+
     #[test]
     fn a_refusal_keeps_the_code_and_the_description_the_licensing_service_gives() {
         let response = serde_json::from_str::<LicenseContentResponse>(
