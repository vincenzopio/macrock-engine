+/// The form Xbox and the licensing service expect of a delegation ticket: t= for a compact JWE
+/// ticket, d= for an opaque one.
+pub(crate) fn delegation_ticket(ticket: String) -> String {
+    use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+    let Some(value) = ticket.strip_prefix("d=") else {
+        return ticket;
+    };
+    let parts: Vec<_> = value.split('.').collect();
+    if parts.len() != 5
+        || parts[0].is_empty()
+        || parts[0].len() > 8192
+        || parts[2..].iter().any(|part| part.is_empty())
+        || !parts.iter().all(|part| {
+            part.len() % 4 != 1
+                && part
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+        })
+    {
+        return ticket;
+    }
+    let valid_header = URL_SAFE_NO_PAD
+        .decode(parts[0])
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<serde_json::Value>(&bytes).ok())
+        .is_some_and(|header| {
+            ["alg", "enc"].iter().all(|key| {
+                header
+                    .get(key)
+                    .and_then(|value| value.as_str())
+                    .is_some_and(|value| !value.is_empty())
+            })
+        });
+    if valid_header {
+        format!("t={value}")
+    } else {
+        ticket
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::delegation_ticket;
+
+    #[test]
+    fn only_compact_jwe_delegation_tickets_change_prefix() {
+        let jwe = "eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..aXY.Y2lwaGVy.dGFn";
+        assert_eq!(delegation_ticket(format!("d={jwe}")), format!("t={jwe}"));
+        for ticket in [
+            "d=opaque",
+            "d=one.two.three",
+            "d=one.two.three.four.five",
+            "t=opaque",
+        ] {
+            assert_eq!(delegation_ticket(ticket.to_owned()), ticket);
+        }
+    }
+}
